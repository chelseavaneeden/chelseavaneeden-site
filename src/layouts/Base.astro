---
import '../styles/global.css';
import { Font } from 'astro:assets';
import ProposalDialog from '../components/patterns/ProposalDialog.astro';
import WhatsAppFloat from '../components/patterns/WhatsAppFloat.astro';
import { t, type Lang } from '../i18n/ui';
import { getSite } from '../lib/content';

interface Props {
  title: string;
  description?: string;
  lang?: Lang;
  noindex?: boolean;
}

const { title, description, lang = 'en', noindex = false } = Astro.props;

// Launch switch: until PUBLIC_INDEXABLE=true is set (at launch), every page tells search engines to stay away.
// This keeps the workers.dev preview out of Google while the live Framer site carries on.
const indexable = import.meta.env.PUBLIC_INDEXABLE === 'true';
const { contact, proposalForm } = await getSite();
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    {(noindex || !indexable) && <meta name="robots" content="noindex, nofollow" />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <Font cssVariable="--font-playfair" preload={[{ weight: '400 600', style: 'normal' }]} />
    <Font cssVariable="--font-eb-garamond" />
    <Font cssVariable="--font-cormorant" />
    <Font cssVariable="--font-host-grotesk" preload={[{ style: 'normal' }]} />
    <Font cssVariable="--font-martian-mono" preload={[{ style: 'normal' }]} />
  </head>
  <body>
    <a
      href="#main"
      class="type-label sr-only z-(--z-banner) rounded-control bg-accent px-4 py-2 text-accent-ink focus:not-sr-only focus:fixed focus:top-3 focus:left-3"
    >
      {t(lang, 'a11y.skip')}
    </a>
    {contact.whatsappHref && <WhatsAppFloat href={contact.whatsappHref} label={contact.whatsappLabel} />}
    <slot />
    {
      contact.whatsappHref && contact.whatsappNumber && proposalForm && (
        <ProposalDialog form={proposalForm} number={contact.whatsappNumber} whatsappHref={contact.whatsappHref} />
      )
    }
  </body>
</html>
