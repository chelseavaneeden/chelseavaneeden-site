---
import '../styles/global.css';
import { Font } from 'astro:assets';
import EnquiryDialog from '../components/patterns/EnquiryDialog.astro';
import { t, type Lang } from '../i18n/ui';
import { getSite } from '../lib/content';

interface Props {
  title: string;
  description?: string;
  lang?: Lang;
  noindex?: boolean;
  /** An analytics event to record when this page opens, e.g. "intro_purchase" on /welcome. */
  pageEvent?: string;
}

const { title, description, lang = 'en', noindex = false, pageEvent } = Astro.props;

// Launch switch: until PUBLIC_INDEXABLE=true is set (at launch), every page tells search engines to stay away.
// This keeps the workers.dev preview out of Google while the live Framer site carries on.
const indexable = import.meta.env.PUBLIC_INDEXABLE === 'true';
const { contact, enquiry, analytics, bookCta } = await getSite();
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    {(noindex || !indexable) && <meta name="robots" content="noindex, nofollow" />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <Font cssVariable="--font-playfair" preload={[{ weight: '400 600', style: 'normal' }]} />
    <Font cssVariable="--font-eb-garamond" />
    <Font cssVariable="--font-cormorant" />
    <Font cssVariable="--font-host-grotesk" preload={[{ style: 'normal' }]} />
    <Font cssVariable="--font-martian-mono" preload={[{ style: 'normal' }]} />
    {
      analytics.umamiWebsiteId && (
        <script is:inline defer src="https://cloud.umami.is/script.js" data-website-id={analytics.umamiWebsiteId} data-do-not-track="true" />
      )
    }
  </head>
  <body
    data-book-href={bookCta.href}
    data-whatsapp-href={contact.whatsappHref}
    data-page-event={pageEvent}
  >
    <a
      href="#main"
      class="type-label sr-only z-(--z-banner) rounded-control bg-accent px-4 py-2 text-accent-ink focus:not-sr-only focus:fixed focus:top-3 focus:left-3"
    >
      {t(lang, 'a11y.skip')}
    </a>
    <slot />
    <EnquiryDialog enquiry={enquiry} contact={contact} />
  </body>
</html>

<script>
  // Analytics (Umami, only when a website ID is set in Site settings). Clicks are recorded by what they
  // do, wherever the button sits: book_intro, enquiry_open, organiser_page, whatsapp_click.
  // "from" says where: the button's data-track label, or the section it's in.
  type Umami = { track: (name: string, data?: Record<string, string>) => void };
  const umami = () => (window as unknown as { umami?: Umami }).umami;
  const { bookHref, whatsappHref, pageEvent } = document.body.dataset;

  const eventFor = (href: string): string | undefined => {
    if (href === bookHref) return 'book_intro';
    if (/^\/enquire\/?(\?.*)?$/.test(href)) return 'enquiry_open';
    if (href.startsWith('/retreats-events')) return 'organiser_page';
    if (whatsappHref && href === whatsappHref) return 'whatsapp_click';
    return undefined;
  };

  document.addEventListener('click', (event) => {
    const link = (event.target as Element).closest?.('a[href]');
    const name = link && eventFor(link.getAttribute('href') ?? '');
    if (!link || !name) return;
    const from = link.closest<HTMLElement>('[data-track]')?.dataset.track ?? link.closest('[id]')?.id ?? 'page';
    umami()?.track(name, { from, page: location.pathname });
  });

  if (pageEvent) window.addEventListener('load', () => umami()?.track(pageEvent));

  // Fade-in on scroll for [data-reveal] items (styles in global.css). Skipped for people who prefer
  // reduced motion. Items that enter the screen together get increasing delays, so they appear in order.
  const revealItems = document.querySelectorAll<HTMLElement>('[data-reveal]');
  if (revealItems.length && 'IntersectionObserver' in window && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    document.documentElement.dataset.reveal = 'on';
    const observer = new IntersectionObserver(
      (entries) => {
        entries
          .filter((e) => e.isIntersecting)
          .map((e) => e.target as HTMLElement)
          .sort((a, b) => (a.compareDocumentPosition(b) & Node.DOCUMENT_POSITION_FOLLOWING ? -1 : 1))
          .forEach((el, order) => {
            el.style.setProperty('--reveal-order', String(order));
            el.dataset.revealed = '';
            observer.unobserve(el);
          });
      },
      { rootMargin: '0px 0px -10% 0px', threshold: 0.2 },
    );
    revealItems.forEach((el) => observer.observe(el));
  }
</script>
