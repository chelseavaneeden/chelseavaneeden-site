---
/*
 * The layout for an audience page (retreats & events). Content comes from
 * src/content/audience-pages/<audience>.yaml, plus the offers and testimonials tagged for that
 * audience. Sections the editor leaves empty are skipped. Private clients have the home page instead.
 *
 * The header button is the page's own main action (e.g. Request a proposal), so organisers never see
 * the intro session button. Page-specific extras can be slotted in: slot="after-offers" or slot="after-formats".
 */
import Base from './Base.astro';
import Section from '../components/ui/Section.astro';
import Checklist from '../components/patterns/Checklist.astro';
import AboutSection from '../components/patterns/AboutSection.astro';
import CtaBand from '../components/patterns/CtaBand.astro';
import FAQAccordion from '../components/patterns/FAQAccordion.astro';
import FeatureGrid from '../components/patterns/FeatureGrid.astro';
import Footer from '../components/patterns/Footer.astro';
import Header from '../components/patterns/Header.astro';
import Hero from '../components/patterns/Hero.astro';
import LogoStrip from '../components/patterns/LogoStrip.astro';
import OfferGrid from '../components/patterns/OfferGrid.astro';
import ProofStrip from '../components/patterns/ProofStrip.astro';
import SectionHeader from '../components/patterns/SectionHeader.astro';
import StepList from '../components/patterns/StepList.astro';
import StickyCta from '../components/patterns/StickyCta.astro';
import TestimonialGrid from '../components/patterns/TestimonialGrid.astro';
import TrustLine from '../components/patterns/TrustLine.astro';
import { getAudiencePage, getOffers, getPage, getSite, getTestimonials, resolveHeroLinks, type Audience } from '../lib/content';

interface Props {
  audience: Audience;
}

const { audience } = Astro.props;
const site = await getSite();
const page = await getAudiencePage(audience);
const offers = await getOffers(audience);
const testimonials = await getTestimonials(audience);
const hero = resolveHeroLinks(page.hero, site);
// The About section and logo banner are shared with the home page, so they are edited in one place.
const { about, logos } = await getPage('home');
---

<Base title={page.seo.title} description={page.seo.description}>
  <Header nav={site.nav} cta={page.hero.primary} sections={[testimonials.length > 0 && 'reviews', 'about', page.faq && 'faq'].filter((s): s is string => !!s)} />

  <main id="main">
    <Hero {...hero}>
      <TrustLine slot="trust" trust={{ items: site.trust.items }} />
    </Hero>

    {/* Who she is and her credentials, straight after the header: organisers want to know her first (Chelsea, 8 Nov). */}
    <AboutSection about={about} />

    {
      page.credentials && page.credentials.stats.length > 0 && (
        <Section space="s" class="overflow-x-clip pt-0">
          <ProofStrip stats={page.credentials.stats} look={page.credentials.look} />
        </Section>
      )
    }

    {/* The logo banner sits with her credentials, so proof comes before the form. */}
    {
      logos && (
        <Section space="s" bare class="pt-0">
          <LogoStrip {...logos} />
        </Section>
      )
    }

    {/* "Perfect for" is a light, faded sage, like on the private page. */}
    <Section space="m" tone="alt" tint="sage">
      <Checklist {...page.whoFor} />
    </Section>

    {/* Formats and "from" prices sit above How it works and the form, so organisers know the cost level before
        they ask (research, 8 Nov). The cards are the Retreats & Events offers under Offers & prices. */}
    {
      offers.length > 0 && page.investment && (
        <Section space="m" id="investment" labelledby="investment-title">
          <OfferGrid {...page.investment} offers={offers} headingId="investment-title" />
        </Section>
      )
    }
    <slot name="after-offers" />

    {
      page.formats && (
        <Section space="m">
          <FeatureGrid {...page.formats} variant="cards" />
        </Section>
      )
    }
    <slot name="after-formats" />

    {
      page.steps && (
        <Section space="m" tone="alt">
          <StepList {...page.steps} />
        </Section>
      )
    }

    {/* The proposal form comes after "How it works", so organisers know what happens before they ask. */}
    {
      page.enquiry && (
        <Section space="m" id="enquire">
          <div class="grid grid-cols-1 gap-10 lg:grid-cols-12" data-form-scope>
            <div class="lg:col-span-5" data-form-intro>
              <SectionHeader {...page.enquiry} />
            </div>
            <div class="lg:col-span-7">
              <slot name="enquiry" />
            </div>
          </div>
        </Section>
      )
    }


    {
      testimonials.length > 0 && (
        <Section space="m" id="reviews">
          <TestimonialGrid eyebrow={page.proof.eyebrow} title={page.proof.title} testimonials={testimonials} />
        </Section>
      )
    }

    {/* Where she has taught, and a link to her private-client reviews, just above Good to know (Chelsea, 8 Nov). */}
    {
      page.experience && (
        <Section space="m" tone="alt">
          <FeatureGrid {...page.experience} variant="cards" />
        </Section>
      )
    }

    {
      page.faq && (
        <Section space="m" id="faq">
          <FAQAccordion {...page.faq} />
        </Section>
      )
    }

    {page.ctaBand && <CtaBand {...page.ctaBand} />}
  </main>

  {/* On phones the header's button folds into the menu, so the page's main action stays within reach here. */}
  <StickyCta label={page.hero.primary.label} href={page.hero.primary.href} />

  <Footer links={site.footerLinks} tagline={site.tagline} location={site.location} socials={site.socials} legal={site.legal} copyrightYear={site.copyrightYear} />
</Base>
