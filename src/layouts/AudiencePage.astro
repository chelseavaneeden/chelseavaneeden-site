---
/*
 * One layout for every audience page (retreats & events, and later brands, studios & clinics,
 * companies). Content comes from src/content/audience-pages/<audience>.yaml, plus the offers and
 * testimonials tagged for that audience. Sections the editor leaves empty are skipped.
 * Private clients have the home page instead; private.yaml only holds the shared reviews heading
 * and questions.
 *
 * The header button is the page's own main action (e.g. Request a proposal), so organisers never see
 * the intro pack button. Page-specific extras can be slotted in: slot="after-formats" or slot="after-offers".
 */
import Base from './Base.astro';
import LeafShadow from '../components/ui/LeafShadow.astro';
import Section from '../components/ui/Section.astro';
import Checklist from '../components/patterns/Checklist.astro';
import CtaBand from '../components/patterns/CtaBand.astro';
import FAQAccordion from '../components/patterns/FAQAccordion.astro';
import FeatureGrid from '../components/patterns/FeatureGrid.astro';
import Footer from '../components/patterns/Footer.astro';
import Header from '../components/patterns/Header.astro';
import Hero from '../components/patterns/Hero.astro';
import OfferGrid from '../components/patterns/OfferGrid.astro';
import SectionHeader from '../components/patterns/SectionHeader.astro';
import StepList from '../components/patterns/StepList.astro';
import TestimonialGrid from '../components/patterns/TestimonialGrid.astro';
import TrustLine from '../components/patterns/TrustLine.astro';
import { getAudiencePage, getOffers, getSite, getTestimonials, resolveHeroLinks, type Audience } from '../lib/content';

interface Props {
  audience: Audience;
}

const { audience } = Astro.props;
const site = await getSite();
const page = await getAudiencePage(audience);
const offers = await getOffers(audience);
const testimonials = await getTestimonials(audience);
const hero = resolveHeroLinks(page.hero, site);
const sage = page.sectionColour === 'sage';
---

<Base title={page.seo.title} description={page.seo.description} mood={page.sectionColour}>
  <Header nav={site.nav} cta={page.hero.primary} sections={[testimonials.length > 0 && 'reviews', page.faq && 'faq'].filter((s): s is string => !!s)} />

  <main id="main">
    <Hero layout="split" {...hero} light={sage ? 'meadow' : 'sunrise'}>
      <TrustLine slot="trust" trust={{ items: site.trust.items }} />
    </Hero>

    <Section space="m" tone="alt">
      {sage && <LeafShadow placement="section" />}
      <Checklist {...page.whoFor} />
    </Section>

    {/* The proposal form comes straight after "Perfect for", so organisers can ask right away. */}
    {
      page.enquiry && (
        <Section space="m" id="enquire">
          <div class="grid grid-cols-1 gap-10 lg:grid-cols-12">
            <div class="lg:col-span-5">
              <SectionHeader {...page.enquiry} />
            </div>
            <div class="lg:col-span-7">
              <slot name="enquiry" />
            </div>
          </div>
        </Section>
      )
    }

    {
      page.formats && (
        <Section space="m">
          <FeatureGrid {...page.formats} variant="cards" />
        </Section>
      )
    }
    <slot name="after-formats" />

    {
      page.steps && (
        <Section space="m" tone="alt">
          {sage && <LeafShadow placement="section" />}
          <StepList {...page.steps} />
        </Section>
      )
    }

    {
      offers.length > 0 && page.investment && (
        <Section space="m" tone="alt" id="investment" labelledby="investment-title">
          <OfferGrid {...page.investment} offers={offers} headingId="investment-title" />
        </Section>
      )
    }
    <slot name="after-offers" />

    {
      testimonials.length > 0 && (
        <Section space="m" id="reviews">
          <TestimonialGrid eyebrow={page.proof.eyebrow} title={page.proof.title} testimonials={testimonials} />
        </Section>
      )
    }

    {
      page.faq && (
        <Section space="m" id="faq">
          <FAQAccordion {...page.faq} />
        </Section>
      )
    }

    {page.ctaBand && <CtaBand {...page.ctaBand} />}
  </main>

  <Footer links={site.footerLinks} tagline={site.tagline} location={site.location} socials={site.socials} legal={site.legal} copyrightYear={site.copyrightYear} />
</Base>
