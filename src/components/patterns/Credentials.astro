---
// Proof that sits beside a form or inside a section: a few headline facts two to a row, then short
// lines marked with the ✺. Words come from the editor (e.g. audience page → Credentials).
import Icon from '../ui/Icon.astro';

interface Props {
  stats?: { value: string; label: string }[];
  points?: string[];
  class?: string;
}

const { stats = [], points = [], class: className } = Astro.props;
---

<div class:list={['flex flex-col gap-8', className]}>
  {
    stats.length > 0 && (
      <dl class="grid grid-cols-2 gap-x-6 gap-y-7 border-t border-line pt-7">
        {stats.map((s) => (
          <div data-reveal class="flex flex-col gap-1.5">
            <dt class="type-body-s order-2 text-ink-muted">{s.label}</dt>
            <dd class="type-stat order-1 text-heading">{s.value}</dd>
          </div>
        ))}
      </dl>
    )
  }
  {
    points.length > 0 && (
      <ul class="flex flex-col gap-4">
        {points.map((point) => (
          <li data-reveal class="flex items-start gap-3">
            <Icon name="burst" class="mt-0.5 size-(--list-mark-size) stroke-2 text-list-mark" />
            <span class="type-body text-pretty text-ink">{point}</span>
          </li>
        ))}
      </ul>
    )
  }
</div>
