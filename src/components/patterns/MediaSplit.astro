---
import type { ImageMetadata } from 'astro';
import Button from '../ui/Button.astro';
import Eyebrow from '../ui/Eyebrow.astro';
import Heading from '../ui/Heading.astro';
import Img from '../ui/Img.astro';
import Text from '../ui/Text.astro';

interface Props {
  image: ImageMetadata;
  imageAlt: string;
  eyebrow?: string;
  title: string;
  text: string[];
  cta?: { label: string; href: string };
  /** Put the image on the right instead of the left. */
  reverse?: boolean;
  ratio?: 'portrait' | 'square' | 'landscape';
}

const { image, imageAlt, eyebrow, title, text, cta, reverse = false, ratio = 'portrait' } = Astro.props;
---

<div class="grid grid-cols-1 items-center gap-10 lg:grid-cols-12 lg:gap-16">
  <div class:list={['lg:col-span-5', reverse && 'lg:order-2 lg:col-start-8']}>
    <Img src={image} alt={imageAlt} ratio={ratio} sizes="(min-width: 1024px) 40vw, 100vw" />
  </div>
  <div class:list={['flex flex-col gap-6 lg:col-span-6', reverse ? 'lg:order-1 lg:col-start-1' : 'lg:col-start-7']}>
    {eyebrow && <Eyebrow rule>{eyebrow}</Eyebrow>}
    <Heading variant="h1" text={title} />
    <div class="flex flex-col gap-4">
      {text.map((p) => <Text tone="muted" text={p} />)}
    </div>
    {
      cta && (
        <div>
          <Button href={cta.href} variant="link" icon="arrow-right">
            {cta.label}
          </Button>
        </div>
      )
    }
  </div>
</div>
