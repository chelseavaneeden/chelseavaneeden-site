---
import Button from '../ui/Button.astro';
import Text from '../ui/Text.astro';
import SectionHeader from './SectionHeader.astro';
import type { Testimonial } from '../../lib/content';

interface Props {
  eyebrow?: string;
  title: string;
  testimonials: Testimonial[];
  /** Optional link under the quotes, e.g. to your Google reviews (opens in a new tab). */
  link?: { label: string; href: string };
  /** Card colour: raised (paper) by default, or alt (sage) on a cream section. */
  cardTone?: 'raised' | 'alt';
}

const { eyebrow, title, testimonials, link, cardTone = 'raised' } = Astro.props;
const cols = testimonials.length === 1 ? '' : testimonials.length === 2 ? 'md:grid-cols-2' : 'md:grid-cols-2 lg:grid-cols-3';
---

<div class="flex flex-col gap-10 md:gap-14">
  <SectionHeader eyebrow={eyebrow} title={title} />
  <ul class:list={['grid grid-cols-1 gap-4', cols]}>
    {
      testimonials.map((t) => (
        <li>
          <figure
            data-tone={cardTone === 'alt' ? 'alt' : undefined}
            class:list={['flex h-full flex-col justify-between gap-8 rounded-card p-7 md:p-8', cardTone === 'alt' ? 'bg-surface' : 'bg-surface-raised']}
          >
            <div class="flex flex-col gap-3">
              <span class="type-h1 leading-none text-logo-mark" aria-hidden="true">
                “
              </span>
              <Text as="blockquote" variant="lede" class="-mt-4">
                {t.quote}
              </Text>
            </div>
            <figcaption class="flex flex-col gap-1 border-t border-line pt-5">
              <span class="type-label text-ink">{t.name}</span>
              {t.context && <span class="type-body-s text-ink-muted">{t.context}</span>}
            </figcaption>
          </figure>
        </li>
      ))
    }
  </ul>
  {
    link && (
      <div>
        <Button href={link.href} variant="secondary" external={/^https?:\/\//.test(link.href)} event="reviews_link">
          {link.label}
        </Button>
      </div>
    )
  }
</div>
