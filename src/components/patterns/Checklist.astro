---
// A section heading with a ticked list below it, a line between rows.
// The list runs in two columns on wide screens; balanced wrapping avoids a lone word on the last line.
import Icon from '../ui/Icon.astro';
import SectionHeader from './SectionHeader.astro';

interface Props {
  eyebrow?: string;
  title: string;
  intro?: string;
  items: string[];
}

const { eyebrow, title, intro, items } = Astro.props;
---

<div class="flex flex-col gap-10 md:gap-14">
  <SectionHeader eyebrow={eyebrow} title={title} intro={intro} />
  <ul class="grid grid-cols-1 border-b border-line lg:grid-cols-2 lg:gap-x-16">
    {
      items.map((item) => (
        <li class="flex items-start gap-4 border-t border-line py-5">
          <Icon name="check" class="mt-1 text-lg text-accent" />
          <span class="type-body text-balance text-ink">{item}</span>
        </li>
      ))
    }
  </ul>
</div>
