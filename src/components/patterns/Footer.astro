---
import Container from '../ui/Container.astro';
import Icon from '../ui/Icon.astro';
import Logo from '../ui/Logo.astro';
import Text from '../ui/Text.astro';
import { t, type Lang } from '../../i18n/ui';
import type { NavItem } from '../../data/draft';

interface Link {
  label: string;
  href: string;
}

interface Props {
  nav: NavItem[];
  tagline: string;
  location: string;
  socials: Link[];
  legal: Link[];
  lang?: Lang;
}

const { nav, tagline, location, socials, legal, lang = 'en' } = Astro.props;
const year = new Date().getFullYear();
const links = nav.flatMap((item) => (item.children ? item.children : [item])).filter((i) => !i.external);
---

<footer data-tone="alt" class="pt-(--space-section-s) pb-10">
  <Container width="wide" class="flex flex-col gap-14">
    <div class="grid grid-cols-1 gap-10 md:grid-cols-12">
      <div class="flex flex-col gap-4 md:col-span-5">
        <a href="/" class="self-start" aria-label="Chelsea van Eeden, home"><Logo size="l" label="Chelsea van Eeden" /></a>
        <Text variant="body-s" tone="muted" class="max-w-xs">{tagline}</Text>
      </div>
      <nav aria-label="Footer" class="md:col-span-4">
        <ul class="grid grid-cols-2 gap-x-6 gap-y-2.5">
          {
            links.map((l) => (
              <li>
                <a href={l.href} class="type-body-s text-ink transition-colors hover:text-ink-muted">
                  {l.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
      <ul class="flex flex-col gap-2.5 md:col-span-3">
        {
          socials.map((s) => (
            <li>
              <a
                href={s.href}
                target="_blank"
                rel="noopener"
                class="type-body-s inline-flex items-center gap-1.5 text-ink transition-colors hover:text-ink-muted"
              >
                {s.label}
                <Icon name="arrow-up-right" label={t(lang, 'a11y.external')} />
              </a>
            </li>
          ))
        }
      </ul>
    </div>
    <div class="flex flex-col gap-3 border-t border-line pt-6 md:flex-row md:items-center md:justify-between">
      <Text variant="caption" tone="muted">© {year} Chelsea van Eeden · {location}</Text>
      <ul class="flex flex-wrap gap-5">
        {
          legal.map((l) => (
            <li>
              <a href={l.href} class="type-caption text-ink-muted transition-colors hover:text-ink">
                {l.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </Container>
</footer>
