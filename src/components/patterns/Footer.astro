---
import Container from '../ui/Container.astro';
import Icon from '../ui/Icon.astro';
import Logo from '../ui/Logo.astro';
import Text from '../ui/Text.astro';
import { t, type Lang } from '../../i18n/ui';
import { newTabRule } from '../../lib/content';

interface Link {
  label: string;
  href: string;
}

interface Props {
  /** Footer links to real pages (Site settings → Footer links). */
  links: Link[];
  tagline: string;
  location?: string;
  socials: Link[];
  legal: Link[];
  /** Year in the copyright line; defaults to the current year. */
  copyrightYear?: number;
  lang?: Lang;
}

const { links, tagline, location, socials, legal, copyrightYear, lang = 'en' } = Astro.props;
const newTab = await newTabRule();
const year = copyrightYear ?? new Date().getFullYear();
---

<footer data-tone="alt" data-tint="sage" data-track="footer" class="pt-(--space-section-s) pb-10">
  <Container width="wide" class="flex flex-col gap-14">
    <div class="grid grid-cols-1 gap-10 md:grid-cols-12">
      <div class="flex flex-col gap-4 md:col-span-5">
        <a href="/" class="self-start" aria-label="Chelsea van Eeden, home"><Logo size="l" /></a>
        <Text variant="body-s" tone="muted" class="max-w-xs">{tagline}</Text>
      </div>
      <nav aria-label="Footer" class="md:col-span-4">
        <ul class="grid grid-cols-2 gap-x-6 md:gap-y-2.5">
          {
            links.map((l) => (
              <li>
                <a
                  href={l.href}
                  target={newTab(l.href) ? '_blank' : undefined}
                  rel={newTab(l.href) ? 'noopener' : undefined}
                  class="type-body-s inline-flex min-h-11 items-center text-ink transition-colors hover:text-ink-muted md:min-h-0"
                >
                  {l.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
      {
        socials.length > 0 && (
          <ul class="flex flex-col md:col-span-3 md:gap-2.5">
            {
              socials.map((s) => (
                <li>
                  <a
                    href={s.href}
                    target="_blank"
                    rel="noopener"
                    class="type-body-s inline-flex min-h-11 items-center gap-1.5 text-ink transition-colors hover:text-ink-muted md:min-h-0"
                  >
                    {s.label}
                    <Icon name="arrow-up-right" label={t(lang, 'a11y.external')} />
                  </a>
                </li>
              ))
            }
          </ul>
        )
      }
    </div>
    <div class="flex flex-col gap-3 border-t border-line pt-6 md:flex-row md:items-center md:justify-between">
      <Text variant="caption" tone="muted">© {year} Chelsea van Eeden{location && ` · ${location}`}</Text>
      <ul class="flex flex-wrap gap-x-5 md:gap-5">
        {
          legal.map((l) => (
            <li>
              <a
                href={l.href}
                target={newTab(l.href) ? '_blank' : undefined}
                rel={newTab(l.href) ? 'noopener' : undefined}
                class="type-caption inline-flex min-h-11 items-center text-ink-muted transition-colors hover:text-ink md:min-h-0"
              >
                {l.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </Container>
</footer>
