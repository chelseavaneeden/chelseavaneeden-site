---
import type { ImageMetadata } from 'astro';
import BgVideo from '../ui/BgVideo.astro';
import Button from '../ui/Button.astro';
import Container from '../ui/Container.astro';
import Eyebrow from '../ui/Eyebrow.astro';
import Heading from '../ui/Heading.astro';
import Img, { type ImgFocus } from '../ui/Img.astro';
import Sunlight from '../ui/Sunlight.astro';
import WhatsAppLink from '../ui/WhatsAppLink.astro';
import Text from '../ui/Text.astro';

export type HeroLayout = 'split' | 'centered' | 'overlay';

interface Link {
  label: string;
  href: string;
}

interface Props {
  layout?: HeroLayout;
  eyebrow?: string;
  title: string;
  lede: string;
  primary: Link;
  /** Optional outlined button shown right after the main button. */
  extra?: Link;
  secondary?: Link;
  /** Show the second action as the WhatsApp link instead of a text link. */
  secondaryStyle?: 'button' | 'whatsapp';
  meta?: string[];
  image: ImageMetadata;
  imageAlt: string;
  imageFocus?: ImgFocus;
  /** A looping, muted video shown instead of the photo (split: on the right; glass: behind the text). */
  /** speed: playback rate, e.g. 0.8 for slightly slower than filmed. */
  video?: { src: string; poster: string; speed?: number };
  /** Glass layout only: where the text card sits on wide screens. */
  textPosition?: 'center' | 'left';
  tone?: 'light' | 'alt' | 'dark';
}

const {
  layout = 'split',
  eyebrow,
  title,
  lede,
  primary,
  extra,
  secondary,
  secondaryStyle = 'button',
  meta = [],
  image,
  imageAlt,
  imageFocus = 'center',
  textPosition = 'center',
  video,
  tone = 'light',
} = Astro.props;
const hasBadge = Astro.slots.has('badge');
const hasTrust = Astro.slots.has('trust');
const isExternal = (href: string) => /^https?:\/\//.test(href);
---

{
  layout === 'split' && (
    <section
      data-tone={tone}
      data-cta="camel"
      class="relative isolate -mt-(--header-h) overflow-hidden pt-(--hero-pad) pb-(--space-section-m) md:-mt-(--header-h-md) md:pt-(--hero-pad-md)"
    >
      {/* Sunrise in the forest: warm light from the top right, sun rays, drifting light, and contour
          lines in the bottom left corner. The header's text rises in on load. */}
      <Sunlight />
      <Container width="wide" class="grid grid-cols-1 items-center gap-12 lg:grid-cols-12 lg:gap-16">
        <div class:list={['flex flex-col gap-7', video ? 'lg:col-span-6' : 'lg:col-span-7']}>
          {hasBadge && <div class="rise-1"><slot name="badge" /></div>}
          {eyebrow && <Eyebrow class="rise-1">{eyebrow}</Eyebrow>}
          <Heading level={1} variant="display-xl" text={title} class="rise-2" />
          <Text variant="lede" tone="muted" class="rise-3 max-w-prose" text={lede} />
          <div class="rise-4 flex flex-wrap items-center gap-x-6 gap-y-4">
            <Button href={primary.href} size="l" event="hero">{primary.label}</Button>
            {extra && <Button href={extra.href} size="l" variant="secondary" event="hero_extra">{extra.label}</Button>}
            {secondary && (secondaryStyle === 'whatsapp' ? <WhatsAppLink href={secondary.href} label={secondary.label} size="m" /> : <Button href={secondary.href} variant="link" event="hero" icon={isExternal(secondary.href) ? 'arrow-up-right' : undefined}>{secondary.label}</Button>)}
          </div>
          {hasTrust && <div class="rise-5"><slot name="trust" /></div>}
          {meta.length > 0 && (
            <ul class="rise-5 flex flex-wrap gap-x-6 gap-y-2 border-t border-line pt-6">
              {meta.map((m) => (
                <li class="type-body-s text-ink-muted">{m}</li>
              ))}
            </ul>
          )}
        </div>
        {video ? (
          <div class="sun-in relative aspect-4/3 overflow-hidden rounded-media shadow-raised lg:col-span-6">
            <BgVideo src={video.src} poster={video.poster} speed={video.speed} focus={imageFocus} />
            {/* A soft golden-hour tint over the video. */}
            <span class="hero-warmth pointer-events-none absolute inset-0" aria-hidden="true"></span>
            <span class="sr-only">{imageAlt}</span>
          </div>
        ) : (
          <div class="sun-in lg:col-span-5">
            <Img src={image} alt={imageAlt} focus={imageFocus} ratio="portrait" priority sizes="(min-width: 1024px) 38vw, 100vw" />
          </div>
        )}
      </Container>
    </section>
  )
}

{
  layout === 'centered' && (
    <section data-tone={tone} class="pt-(--space-section-s) pb-(--space-section-s)">
      <Container width="narrow" class="flex flex-col items-center gap-7 text-center">
        {hasBadge && <slot name="badge" />}
        {eyebrow && <Eyebrow>{eyebrow}</Eyebrow>}
        <Heading level={1} variant="display-xl" text={title} />
        <Text variant="lede" tone="muted" class="max-w-prose" text={lede} />
        <div class="flex flex-wrap justify-center gap-3">
          <Button href={primary.href} size="l" event="hero">{primary.label}</Button>
          {extra && <Button href={extra.href} size="l" variant="secondary" event="hero_extra">{extra.label}</Button>}
          {secondary && (secondaryStyle === 'whatsapp' ? <WhatsAppLink href={secondary.href} label={secondary.label} size="m" /> : <Button href={secondary.href} variant="link" event="hero" icon={isExternal(secondary.href) ? 'arrow-up-right' : undefined}>{secondary.label}</Button>)}
        </div>
      </Container>
      <Container width="wide" class="mt-(--space-section-s)">
        <Img src={image} alt={imageAlt} focus={imageFocus} ratio="wide" priority sizes="(min-width: 1472px) 1400px, 94vw" class="max-md:aspect-4/5" />
        {meta.length > 0 && (
          <ul class="mt-6 flex flex-wrap justify-center gap-x-8 gap-y-2">
            {meta.map((m) => (
              <li class="type-body-s text-ink-muted">{m}</li>
            ))}
          </ul>
        )}
      </Container>
    </section>
  )
}

{
  layout === 'overlay' && (
    <section
      data-tone={tone}
      class="relative isolate flex flex-col overflow-hidden lg:min-h-(--hero-overlay-height) lg:flex-row lg:items-center lg:px-(--gutter) lg:py-(--space-section-m)"
    >
      <div class="relative aspect-4/5 w-full overflow-hidden rounded-none lg:absolute lg:inset-0 lg:-z-10 lg:aspect-auto" aria-hidden="true">
        {
          video ? (
            <BgVideo src={video.src} poster={video.poster} speed={video.speed} focus={imageFocus} />
          ) : (
            <Img src={image} alt="" focus={imageFocus} ratio="fill" priority sizes="100vw" class="w-full" />
          )
        }
      </div>
      <div
        class:list={[
          'relative mx-auto -mt-24 flex w-full max-w-wide justify-center px-(--gutter) pb-(--space-section-s) lg:mt-0 lg:px-0 lg:pb-0',
          textPosition === 'left' && 'lg:justify-start',
        ]}
      >
      <div
        class:list={[
          'flex max-w-xl flex-col items-center gap-6 rounded-card border border-line bg-surface/75 px-7 py-10 text-center shadow-raised backdrop-blur-md md:px-12 md:py-14',
          textPosition === 'left' && 'lg:items-start lg:text-left',
        ]}
      >
        {hasBadge && <slot name="badge" />}
        {eyebrow && <Eyebrow>{eyebrow}</Eyebrow>}
        <Heading level={1} variant="display-l" text={title} />
        <Text variant="body" tone="muted" class="max-w-md" text={lede} />
        <Button href={primary.href} size="m" event="hero">{primary.label}</Button>
        {extra && <Button href={extra.href} size="m" variant="secondary" event="hero_extra">{extra.label}</Button>}
        {secondary &&
          (secondaryStyle === 'whatsapp' ? (
            <WhatsAppLink href={secondary.href} label={secondary.label} size="m" />
          ) : (
            <Button href={secondary.href} variant="link" event="hero" icon={isExternal(secondary.href) ? 'arrow-up-right' : undefined}>
              {secondary.label}
            </Button>
          ))}
      </div>
      </div>
      <span class="sr-only">{imageAlt}</span>
    </section>
  )
}

<style>
  .hero-warmth {
    background-image: var(--video-warmth);
    mix-blend-mode: soft-light;
  }
</style>
