---
import type { ImageMetadata } from 'astro';
import Button from '../ui/Button.astro';
import Container from '../ui/Container.astro';
import Eyebrow from '../ui/Eyebrow.astro';
import Heading from '../ui/Heading.astro';
import Img, { type ImgFocus } from '../ui/Img.astro';
import Text from '../ui/Text.astro';

export type HeroLayout = 'split' | 'centered';

interface Link {
  label: string;
  href: string;
}

interface Props {
  layout?: HeroLayout;
  eyebrow: string;
  title: string;
  lede: string;
  primary: Link;
  secondary?: Link;
  meta?: string[];
  image: ImageMetadata;
  imageAlt: string;
  imageFocus?: ImgFocus;
  tone?: 'light' | 'alt' | 'dark';
}

const {
  layout = 'split',
  eyebrow,
  title,
  lede,
  primary,
  secondary,
  meta = [],
  image,
  imageAlt,
  imageFocus = 'center',
  tone = 'light',
} = Astro.props;
const hasBadge = Astro.slots.has('badge');
---

{
  layout === 'split' && (
    <section data-tone={tone} class="pt-(--space-section-s) pb-(--space-section-s)">
      <Container width="wide" class="grid grid-cols-1 items-center gap-12 lg:grid-cols-12 lg:gap-16">
        <div class="flex flex-col gap-7 lg:col-span-7">
          {hasBadge && <div><slot name="badge" /></div>}
          <Eyebrow>{eyebrow}</Eyebrow>
          <Heading level={1} variant="display-xl" text={title} />
          <Text variant="lede" tone="muted" class="max-w-prose" text={lede} />
          <div class="flex flex-wrap items-center gap-3">
            <Button href={primary.href} size="l" event="hero_primary">{primary.label}</Button>
            {secondary && <Button href={secondary.href} size="l" variant="ghost" icon="arrow-right">{secondary.label}</Button>}
          </div>
          {meta.length > 0 && (
            <ul class="flex flex-wrap gap-x-6 gap-y-2 border-t border-line pt-6">
              {meta.map((m) => (
                <li class="type-body-s text-ink-muted">{m}</li>
              ))}
            </ul>
          )}
        </div>
        <div class="lg:col-span-5">
          <Img src={image} alt={imageAlt} focus={imageFocus} ratio="portrait" priority sizes="(min-width: 1024px) 38vw, 100vw" />
        </div>
      </Container>
    </section>
  )
}

{
  layout === 'centered' && (
    <section data-tone={tone} class="pt-(--space-section-s) pb-(--space-section-s)">
      <Container width="narrow" class="flex flex-col items-center gap-7 text-center">
        {hasBadge && <slot name="badge" />}
        <Eyebrow>{eyebrow}</Eyebrow>
        <Heading level={1} variant="display-xl" text={title} />
        <Text variant="lede" tone="muted" class="max-w-prose" text={lede} />
        <div class="flex flex-wrap justify-center gap-3">
          <Button href={primary.href} size="l" event="hero_primary">{primary.label}</Button>
          {secondary && <Button href={secondary.href} size="l" variant="ghost" icon="arrow-right">{secondary.label}</Button>}
        </div>
      </Container>
      <Container width="wide" class="mt-(--space-section-s)">
        <Img src={image} alt={imageAlt} focus={imageFocus} ratio="wide" priority sizes="(min-width: 1472px) 1400px, 94vw" class="max-md:aspect-4/5" />
        {meta.length > 0 && (
          <ul class="mt-6 flex flex-wrap justify-center gap-x-8 gap-y-2">
            {meta.map((m) => (
              <li class="type-body-s text-ink-muted">{m}</li>
            ))}
          </ul>
        )}
      </Container>
    </section>
  )
}

