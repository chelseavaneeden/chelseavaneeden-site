---
// The "Ask me a question" pop-up, and the "Join waitlist" pop-up when Chelsea is fully booked. Every link to
// /enquire opens the question form and every link to /waitlist opens the waitlist form, instead of leaving the page
// (Questions first? Ask me, Ask a question, Join waitlist…). Without JavaScript those links open the pages themselves.
import Icon from '../ui/Icon.astro';
import EnquiryForm from './EnquiryForm.astro';
import type { Site } from '../../lib/content';

interface Props {
  enquiry: Site['enquiry'];
  contact: Site['contact'];
}

const { enquiry, contact } = Astro.props;
---

{/* The panel is centred with m-auto: it stays centred when it fits and scrolls from the top when
    it doesn't (centring with items-center would push a tall panel's top off-screen). */}
<dialog
  id="enquiry-dialog"
  aria-labelledby="dialog-question-title"
  class="size-full max-h-none max-w-none overflow-y-auto bg-transparent p-(--gutter) backdrop:bg-ink/50 open:flex"
>
  <div class="relative m-auto flex w-full max-w-2xl flex-col rounded-card bg-surface-paper p-6 text-ink shadow-raised md:p-8">
    <button
      type="button"
      data-close
      aria-label="Close"
      class="absolute top-3 right-3 flex size-11 items-center justify-center rounded-pill text-xl text-ink transition-colors hover:bg-surface-alt"
    >
      <Icon name="close" />
    </button>
    <div data-dialog-form="question">
      <EnquiryForm type="question" enquiry={enquiry} contact={contact} showTitle idPrefix="dialog-question" />
    </div>
    <div data-dialog-form="waitlist" hidden>
      <EnquiryForm type="waitlist" enquiry={enquiry} contact={contact} showTitle idPrefix="dialog-waitlist" />
    </div>
  </div>
</dialog>

<script>
  const dialog = document.querySelector<HTMLDialogElement>('#enquiry-dialog');

  /** Which form a link opens: /enquire → the question form, /waitlist → the waitlist form. */
  const formFor = (href: string) => (/^\/waitlist\/?(\?.*)?$/.test(href) ? 'waitlist' : /^\/enquire\/?(\?.*)?$/.test(href) ? 'question' : undefined);

  if (dialog) {
    document.addEventListener('click', (event) => {
      const link = (event.target as Element).closest?.('a[href]');
      const which = formFor(link?.getAttribute('href') ?? '');
      if (!which) return;
      event.preventDefault();
      dialog.querySelectorAll<HTMLElement>('[data-dialog-form]').forEach((el) => (el.hidden = el.dataset.dialogForm !== which));
      dialog.setAttribute('aria-labelledby', `dialog-${which}-title`);
      dialog.showModal();
    });

    // Close with the × or by clicking outside the panel (Esc works natively).
    dialog.addEventListener('click', (event) => {
      const target = event.target as Element;
      if (target === dialog || target.closest('[data-close]')) dialog.close();
    });

    // After a message is sent, the next opening shows an empty form again.
    dialog.addEventListener('close', () => {
      dialog.querySelectorAll<HTMLElement>('[data-enquiry-done].flex').forEach((done) => {
        done.classList.replace('flex', 'hidden');
        done.closest('[data-enquiry-wrap]')?.querySelector('form')?.classList.remove('hidden');
        done.closest('[data-enquiry-wrap]')?.querySelectorAll<HTMLElement>('[data-form-intro]').forEach((el) => (el.hidden = false));
      });
    });
  }
</script>
