---
import Button from '../ui/Button.astro';
import Heading from '../ui/Heading.astro';
import Section from '../ui/Section.astro';
import Sunlight from '../ui/Sunlight.astro';
import Text from '../ui/Text.astro';

interface Link {
  label: string;
  href: string;
}

interface Props {
  title: string;
  text?: string;
  primary: Link;
  secondary?: Link;
  tone?: 'light' | 'alt' | 'dark';
}

const { title, text, primary, secondary, tone = 'dark' } = Astro.props;
---

<!-- A soft, glowing panel that floats on the page (rather than a full-width block), lit by low sun. -->
<Section space="s" width="wide">
  <div data-tone={tone} class="relative isolate overflow-hidden rounded-card px-(--gutter) py-(--space-section-m)">
    <Sunlight variant="dusk" />
    <div data-reveal class="mx-auto grid max-w-content grid-cols-1 gap-8 lg:grid-cols-12 lg:items-end">
      <Heading variant="display-l" text={title} class="lg:col-span-7" />
      <div class="flex flex-col gap-6 lg:col-span-5">
        {text && <Text tone="muted" text={text} />}
        <div class="flex flex-wrap gap-3">
          <Button href={primary.href} size="l" icon="arrow-right" event="closing_band">{primary.label}</Button>
          {secondary && <Button href={secondary.href} size="l" variant="secondary">{secondary.label}</Button>}
        </div>
      </div>
    </div>
  </div>
</Section>
