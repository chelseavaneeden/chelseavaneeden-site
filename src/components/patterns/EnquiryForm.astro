---
// An enquiry form, sent to /api/enquire (worker/). question and proposal arrive in Chelsea's inbox by email;
// intake is saved in Notion and she gets a short email.
// Words come from Site settings → Enquiry forms; `type` picks the form: question, proposal or intake.
// Tap-to-choose questions, name and email, fields in order (text, date, phone, tap-to-choose), required tick boxes, a hidden
// spam trap and, once a site key is set, Cloudflare Turnstile. WhatsApp stays as a small link that
// opens WhatsApp directly.
import Heading from '../ui/Heading.astro';
import Text from '../ui/Text.astro';
import WhatsAppLink from '../ui/WhatsAppLink.astro';
import type { Site } from '../../lib/content';

export type EnquiryType = keyof Site['enquiry']['forms'];

interface Props {
  type: EnquiryType;
  enquiry: Site['enquiry'];
  contact: Site['contact'];
  /** Show the form's own heading (in the pop-up). Inline forms sit under a section heading instead. */
  showTitle?: boolean;
  /** Prefix for field ids, so the same form can appear twice on a page (inline and in the pop-up). */
  idPrefix?: string;
}

const { type, enquiry, contact, showTitle = false, idPrefix = type } = Astro.props;
const form = enquiry.forms[type];
const field = 'type-body w-full rounded-control border border-line-control bg-surface-paper px-4 py-3 text-ink placeholder:text-ink-muted aria-invalid:border-error';
const question = 'type-field text-ink group-data-missing/field:text-error';
const chip =
  'type-body-s inline-flex min-h-11 cursor-pointer items-center rounded-pill border border-line-control bg-surface-paper px-4 text-ink transition-colors hover:border-ink has-checked:border-cta has-checked:bg-cta has-checked:text-cta-ink has-focus-visible:outline-2 has-focus-visible:outline-offset-2 has-focus-visible:outline-focus';
const id = (name: string) => `${idPrefix}-${name}`;
const inputType = { text: 'text', date: 'date', tel: 'tel' } as const;
const autocompleteFor = (f: { name: string; type: string }) => (f.type === 'tel' ? 'tel' : f.name === 'birthday' ? 'bday' : undefined);
// Tapping an option called "Other" opens a box to type more (Chelsea, 10 Nov). Its answer is named after the question,
// e.g. "Your goals (other)".
const OTHER = 'other';
const hasOther = (options: string[]) => options.some((o) => o.trim().toLowerCase() === OTHER);
const otherName = (label: string) => `${label.split(/[,?]/)[0].trim()} (other)`;
// The intake form comes after booking, so it skips the WhatsApp and reply-time lines under the button (Chelsea, 10 Nov).
const showContactLines = type !== 'intake';

// Tick-box text can hold one or more links written as [Terms](/terms).
const withLinks = (text: string) =>
  text.split(/(\[[^\]]+\]\([^)\s]+\))/).filter(Boolean).map((part) => {
    const m = part.match(/^\[([^\]]+)\]\(([^)\s]+)\)$/);
    return m ? { text: m[1], href: m[2] } : { text: part, href: undefined };
  });
---

<div class="flex flex-col gap-5" data-enquiry-wrap>
  {
    showTitle && (
      <div class="flex flex-col gap-2 pr-8">
        <Heading level={2} variant="h3" text={form.title} id={id('title')} />
        {form.intro && <Text variant="body-s" tone="muted" text={form.intro} />}
      </div>
    )
  }

  <form class="flex flex-col gap-5" data-enquiry={type} novalidate>
    {
      form.questions.map((q, i) => (
        <fieldset class="group/field" data-short={q.short} data-field={`q${i}`} data-required-label={q.required ? q.label : undefined}>
          <legend class:list={[question, 'mb-2.5']}>
            {q.label} {!q.required && <span class="font-normal text-ink-muted">(optional)</span>}
          </legend>
          <div class="flex flex-wrap gap-2">
            {q.options.map((option) => (
              <label class={chip}>
                <input type="radio" name={`q${i}`} value={option} required={q.required} class="sr-only" />
                {option}
              </label>
            ))}
          </div>
        </fieldset>
      ))
    }

    <div class="grid grid-cols-1 gap-5 sm:grid-cols-2">
      <label class="group/field flex flex-col gap-2" for={id('name')} data-required-label={enquiry.nameLabel}>
        <span class={question}>{enquiry.nameLabel}</span>
        <input id={id('name')} type="text" name="name" required maxlength="100" autocomplete="name" class={field} />
      </label>
      <label class="group/field flex flex-col gap-2" for={id('email')} data-required-label={enquiry.emailLabel}>
        <span class={question}>{enquiry.emailLabel}</span>
        <input
          id={id('email')}
          type="email"
          name="email"
          required
          maxlength="200"
          autocomplete="email"
          aria-describedby={form.emailHint ? id('email-hint') : undefined}
          class={field}
        />
        {/* The hint goes under the field, so Name and Email line up side by side. */}
        {form.emailHint && <span class="type-body-s text-ink-muted" id={id('email-hint')}>{form.emailHint}</span>}
      </label>
    </div>

    {
      form.fields.map((f) =>
        f.type === 'choice' ? (
          <fieldset
            class="group/field"
            data-answer-key={f.name}
            data-answer-label={f.label}
            data-required-label={f.required ? f.label : undefined}
            data-multiple={f.multiple ? '' : undefined}
          >
            <legend class:list={[question, 'mb-2.5']}>
              {f.label} {!f.required && <span class="font-normal text-ink-muted">(optional)</span>}
            </legend>
            <div class="flex flex-wrap gap-2">
              {f.options.map((option) => (
                <label class={chip}>
                  <input
                    type={f.multiple ? 'checkbox' : 'radio'}
                    name={f.name}
                    value={option}
                    required={f.required && !f.multiple}
                    data-other-option={option.trim().toLowerCase() === OTHER ? '' : undefined}
                    class="sr-only"
                  />
                  {option}
                </label>
              ))}
            </div>
            {hasOther(f.options) && (
              <label class="mt-3 hidden flex-col gap-2" for={id(`${f.name}-other`)} data-other-box>
                <span class="type-body-s text-ink-muted">{enquiry.otherLabel}</span>
                <input
                  id={id(`${f.name}-other`)}
                  type="text"
                  name={`${f.name}-other`}
                  maxlength="300"
                  data-other
                  data-other-key={`${f.name}-other`}
                  data-other-label={otherName(f.label)}
                  class={field}
                />
              </label>
            )}
          </fieldset>
        ) : (
          <label class="group/field flex flex-col gap-2" for={id(f.name)} data-required-label={f.required ? f.label : undefined}>
            <span class={question}>
              {f.label} {!f.required && <span class="font-normal text-ink-muted">(optional)</span>}
            </span>
            {f.type === 'textarea' ? (
              <textarea
                id={id(f.name)}
                name={f.name}
                rows="3"
                maxlength="3000"
                required={f.required}
                placeholder={f.placeholder}
                data-answer-key={f.name}
                data-answer-label={f.label}
                class={`${field} resize-y`}
              />
            ) : (
              <input
                id={id(f.name)}
                type={inputType[f.type]}
                name={f.name}
                maxlength={f.type === 'date' ? undefined : '200'}
                required={f.required}
                placeholder={f.placeholder}
                autocomplete={autocompleteFor(f)}
                data-answer-key={f.name}
                data-answer-label={f.label}
                class={field}
              />
            )}
          </label>
        ),
      )
    }

    {
      form.agreements.map((a, i) => (
        <label class="group/field type-body-s flex items-start gap-3 text-ink" for={id(`agree-${i}`)} data-required-label={a.short ?? enquiry.missingTick}>
          <input id={id(`agree-${i}`)} type="checkbox" name={`agree-${i}`} required data-agreement={a.short ?? a.text} class="size-6 shrink-0 accent-ink" />
          <span class="group-data-missing/field:text-error">
            {withLinks(a.text).map((part) => (part.href ? <a href={part.href} class="underline underline-offset-4">{part.text}</a> : part.text))}
          </span>
        </label>
      ))
    }

    {/* Spam trap: hidden from people, often filled in by bots. */}
    <div class="sr-only" aria-hidden="true">
      <label>Leave this empty <input type="text" name="website" tabindex="-1" autocomplete="off" /></label>
    </div>

    {enquiry.turnstileSiteKey && <div class="cf-turnstile" data-sitekey={enquiry.turnstileSiteKey} data-size="flexible" data-theme="light" />}

    <div class="flex flex-col gap-3 pt-1">
      <button
        type="submit"
        class="type-button w-full rounded-pill bg-cta px-7 py-4 text-cta-ink transition duration-(--duration-base) ease-soft hover:bg-cta-hover hover:shadow-glow disabled:cursor-not-allowed disabled:opacity-45 disabled:hover:bg-cta disabled:hover:shadow-none"
      >
        {form.button}
      </button>
      <p class="type-body-s hidden text-center text-error" data-enquiry-missing data-lead={enquiry.missingLead} role="alert"></p>
      {/* WhatsApp first, right under the button, then the reply promise and privacy line (Chelsea, 8 Nov). */}
      {
        showContactLines && contact.whatsappHref && (
          <p class="type-body-s flex flex-wrap items-center justify-center gap-x-2 text-center text-ink-muted">
            Prefer WhatsApp? <WhatsAppLink href={contact.whatsappHref} label={contact.whatsappLabel} />
          </p>
        )
      }
      {
        showContactLines && (
          <p class="type-caption text-center text-balance text-ink-muted" data-enquiry-status role="status" aria-live="polite">
            {enquiry.replyPromise}
            {enquiry.privacyNote && <> {enquiry.privacyNote} <a href="/privacy" class="underline underline-offset-4">Privacy policy</a></>}
          </p>
        )
      }
      <p class="type-body-s hidden text-center text-error" data-enquiry-error role="alert">{enquiry.error}</p>
    </div>
  </form>

  <div class="hidden flex-col items-start gap-3 py-4" data-enquiry-done role="status">
    <Heading level={3} variant="h3" text="Sent, *thank you*" />
    <Text tone="muted" text={enquiry.success} />
  </div>
</div>

{enquiry.turnstileSiteKey && <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>}

<script>
  type Answer = { key: string; label: string; value: string };
  type Umami = { track: (name: string, data?: Record<string, string>) => void };
  type Turnstile = { reset: (el?: Element) => void };

  document.querySelectorAll<HTMLFormElement>('form[data-enquiry]').forEach((form) => {
    const wrap = form.closest('[data-enquiry-wrap]');
    const send = form.querySelector<HTMLButtonElement>('[type=submit]');
    const error = form.querySelector<HTMLElement>('[data-enquiry-error]');
    const done = wrap?.querySelector<HTMLElement>('[data-enquiry-done]');
    const missing = form.querySelector<HTMLElement>('[data-enquiry-missing]');
    if (!send || !error || !done || !missing) return;
    const label = send.textContent;

    const required = [...form.querySelectorAll<HTMLElement>('[data-required-label]')];
    const controlsOf = (el: HTMLElement) => [...el.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>('input:not([data-other]), textarea')];

    // The box under "Other" opens while Other is ticked, and closes again when it isn't.
    const otherBoxes = () =>
      form.querySelectorAll<HTMLElement>('[data-other-box]').forEach((box) => {
        const set = box.closest('fieldset');
        const ticked = Boolean(set?.querySelector<HTMLInputElement>('input[data-other-option]')?.checked);
        box.classList.toggle('hidden', !ticked);
        box.classList.toggle('flex', ticked);
      });
    form.addEventListener('change', otherBoxes);

    // The button is always active. If something is missing, this marks it and names it next to the button,
    // so nobody is left looking at a dead button. Returns the first one.
    // A tap-more-than-one question is answered once anything is ticked; everything else uses the browser's own checks.
    const isUnfinished = (el: HTMLElement) =>
      el.hasAttribute('data-multiple')
        ? !controlsOf(el).some((control) => (control as HTMLInputElement).checked)
        : controlsOf(el).some((control) => !control.validity.valid);
    const flagMissing = () => {
      const unfinished = required.filter(isUnfinished);
      required.forEach((el) => {
        const isMissing = unfinished.includes(el);
        el.toggleAttribute('data-missing', isMissing);
        controlsOf(el).forEach((control) => (isMissing ? control.setAttribute('aria-invalid', 'true') : control.removeAttribute('aria-invalid')));
      });
      missing.textContent = unfinished.length ? `${missing.dataset.lead} ${unfinished.map((el) => el.dataset.requiredLabel).join(' · ')}` : '';
      missing.classList.toggle('hidden', unfinished.length === 0);
      return unfinished[0];
    };

    // Once the message is showing, it updates as each answer is filled in.
    const refresh = () => {
      if (!missing.classList.contains('hidden')) flagMissing();
    };
    form.addEventListener('input', refresh);
    form.addEventListener('change', refresh);

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      const first = flagMissing();
      if (first) {
        first.scrollIntoView({ block: 'center' });
        controlsOf(first)[0]?.focus({ preventScroll: true });
        return;
      }
      const data = new FormData(form);
      const answers: Answer[] = [];
      form.querySelectorAll<HTMLFieldSetElement>('fieldset[data-short]').forEach((set) => {
        const short = set.dataset.short ?? '';
        answers.push({ key: short, label: short, value: String(data.get(set.dataset.field ?? '') ?? '') });
      });
      // The fields in their order: tap-to-choose answers are joined with commas.
      form.querySelectorAll<HTMLElement>('[data-answer-key]').forEach((el) => {
        const key = el.dataset.answerKey ?? '';
        const value =
          el instanceof HTMLFieldSetElement ? data.getAll(key).map(String).join(', ') : (el as HTMLInputElement).value.trim();
        if (value) answers.push({ key, label: el.dataset.answerLabel ?? key, value });
        // What they typed under "Other" follows as its own answer, only while Other is ticked.
        const other = el.querySelector<HTMLInputElement>('input[data-other]');
        const otherTicked = el.querySelector<HTMLInputElement>('input[data-other-option]')?.checked;
        if (other && otherTicked && other.value.trim()) {
          answers.push({ key: other.dataset.otherKey ?? '', label: other.dataset.otherLabel ?? '', value: other.value.trim() });
        }
      });
      const ticks = [...form.querySelectorAll<HTMLInputElement>('input[data-agreement]')];

      send.disabled = true;
      send.textContent = 'Sending…';
      error.classList.add('hidden');
      try {
        const response = await fetch('/api/enquire', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({
            type: form.dataset.enquiry,
            name: String(data.get('name') ?? '').trim(),
            email: String(data.get('email') ?? '').trim(),
            answers,
            consent: ticks.length > 0 && ticks.every((tick) => tick.checked),
            agreed: ticks.filter((tick) => tick.checked).map((tick) => tick.dataset.agreement ?? ''),
            page: location.pathname,
            website: String(data.get('website') ?? ''),
            token: String(data.get('cf-turnstile-response') ?? ''),
          }),
        });
        if (!response.ok) throw new Error(String(response.status));
        (window as unknown as { umami?: Umami }).umami?.track('enquiry_submit', { type: form.dataset.enquiry ?? '' });
        form.reset();
        otherBoxes();
        form.classList.add('hidden');
        done.classList.replace('hidden', 'flex');
      } catch {
        error.classList.remove('hidden');
        (window as unknown as { turnstile?: Turnstile }).turnstile?.reset(form.querySelector('.cf-turnstile') ?? undefined);
      } finally {
        send.textContent = label;
        send.disabled = false;
      }
    });
  });
</script>
