---
import Text from '../ui/Text.astro';
import Icon from '../ui/Icon.astro';
import OfferCard from './OfferCard.astro';
import SectionHeader from './SectionHeader.astro';
import type { Offer } from '../../lib/content';

interface Props {
  eyebrow?: string;
  title: string;
  intro?: string;
  note?: string;
  offers: Offer[];
  cardVariant?: 'raised' | 'outline';
  headingId?: string;
  /** Optional quiet contact link under the cards (WhatsApp). */
  contact?: { lead: string; label: string; href?: string };
}

const { eyebrow, title, intro, note, offers, cardVariant = 'raised', headingId, contact } = Astro.props;
---

<div class="flex flex-col gap-12 md:gap-16">
  <SectionHeader eyebrow={eyebrow} title={title} intro={intro} layout="split" id={headingId} />
  <ul class:list={['grid grid-cols-1 gap-4 md:grid-cols-2', offers.length > 2 && 'xl:grid-cols-3']}>
    {
      offers.map((offer) => (
        <li>
          <OfferCard offer={offer} variant={cardVariant} />
        </li>
      ))
    }
  </ul>
  {
    contact?.href && (
      <p class="type-body-s flex flex-wrap items-center gap-x-2 gap-y-1 text-ink-muted">
        {contact.lead}{' '}
        <a
          href={contact.href}
          target="_blank"
          rel="noopener"
          data-umami-event="whatsapp_click"
          class="inline-flex items-center gap-1.5 text-ink underline decoration-1 underline-offset-4 transition-colors hover:decoration-2"
        >
          <Icon name="message" />
          {contact.label}
        </a>
      </p>
    )
  }
  {note && <Text variant="caption" tone="muted">{note}</Text>}
</div>
