---
import Text from '../ui/Text.astro';
import OfferCard from './OfferCard.astro';
import SectionHeader from './SectionHeader.astro';
import type { Offer } from '../../lib/content';

interface Props {
  eyebrow?: string;
  title: string;
  intro?: string;
  note?: string;
  offers: Offer[];
  cardVariant?: 'raised' | 'outline';
  headingId?: string;
}

const { eyebrow, title, intro, note, offers, cardVariant = 'raised', headingId } = Astro.props;
// Cards with photos need more width (photo on the side), so they sit side by side only on wide screens.
// A single offer always spans the full width; without a photo it uses the wide card layout, like the intro session
// card with words where the photo would be. Four cards sit two by two, so none is left alone on a row.
const withPhotos = offers.some((o) => o.image);
const single = offers.length === 1;
const threeAcross = offers.length > 2 && offers.length !== 4;
---

<div class="flex flex-col gap-12 md:gap-16">
  <SectionHeader eyebrow={eyebrow} title={title} intro={intro} layout="split" id={headingId} />
  <ul
    class:list={[
      'grid grid-cols-1',
      !single && (withPhotos ? 'gap-6 xl:grid-cols-2' : ['gap-4 md:grid-cols-2', threeAcross && 'xl:grid-cols-3']),
    ]}
  >
    {
      offers.map((offer) => (
        <li data-reveal>
          <OfferCard offer={offer} variant={cardVariant} wide={single} />
        </li>
      ))
    }
  </ul>
  {note && <Text variant="caption" tone="muted">{note}</Text>}
</div>
