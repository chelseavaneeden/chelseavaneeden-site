---
// Credentials as soft bubbles across the page. On wider screens they are circles that drift very
// slightly as you scroll, each at its own pace, and line up when they reach the middle of the screen.
// On phones they are full-width pills that stay still. Words come from the editor (audience page →
// Credentials). The drifting is skipped for people who prefer reduced motion.
interface Props {
  stats: { value: string; label: string }[];
}

const { stats } = Astro.props;
// How far each bubble drifts, relative to the scroll: alternating, so they never move in step.
const speeds = [0.05, -0.04, 0.06, -0.05];
---

<ul class="flex flex-col items-stretch gap-3 sm:flex-row sm:flex-wrap sm:justify-center sm:gap-6">
  {
    stats.map((s, i) => (
      <li data-reveal>
        <div
          data-parallax={speeds[i % speeds.length]}
          class="bubble flex items-center gap-4 rounded-pill px-7 py-4 shadow-bubble sm:aspect-square sm:w-(--bubble-size) sm:flex-col sm:justify-center sm:gap-1.5 sm:p-6 sm:text-center"
        >
          <span class="type-h1 shrink-0 whitespace-nowrap text-heading">{s.value}</span>
          <span class="type-body-s text-balance text-ink-muted">{s.label}</span>
        </div>
      </li>
    ))
  }
</ul>

<style>
  .bubble {
    background-image: var(--bubble-surface);
  }

  [data-parallax] {
    translate: 0 var(--parallax-y, 0px);
  }
</style>

<script>
  const bubbles = [...document.querySelectorAll<HTMLElement>('[data-parallax]')];
  const wide = matchMedia('(min-width: 640px)');
  const reduced = matchMedia('(prefers-reduced-motion: reduce)');

  if (bubbles.length) {
    const furthest = 28;
    let frame = 0;

    const update = () => {
      frame = 0;
      const middle = innerHeight / 2;
      bubbles.forEach((bubble) => {
        const parent = bubble.parentElement ?? bubble;
        const rect = parent.getBoundingClientRect();
        const shift = (middle - (rect.top + rect.height / 2)) * Number(bubble.dataset.parallax);
        const y = wide.matches && !reduced.matches ? Math.max(-furthest, Math.min(furthest, shift)) : 0;
        bubble.style.setProperty('--parallax-y', `${y.toFixed(1)}px`);
      });
    };

    const onChange = () => {
      if (!frame) frame = requestAnimationFrame(update);
    };

    addEventListener('scroll', onChange, { passive: true });
    addEventListener('resize', onChange);
    update();
  }
</script>
