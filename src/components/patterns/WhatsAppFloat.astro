---
// Round WhatsApp button fixed to the bottom-right corner of every page; opens WhatsApp in a new tab.
// It shares the header's layer and comes first in the page, so the open mobile menu covers it.
import Icon from '../ui/Icon.astro';

interface Props {
  href: string;
  label: string;
}

const { href, label } = Astro.props;
---

<a
  href={href}
  target="_blank"
  rel="noopener"
  aria-label={label}
  title={label}
  data-umami-event="whatsapp_float"
  class="fixed right-(--gutter) bottom-(--gutter) z-(--z-header) flex size-14 items-center justify-center rounded-pill bg-cta text-cta-ink shadow-raised transition-transform duration-(--duration-fast) ease-soft hover:scale-105 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-focus"
>
  <Icon name="whatsapp" class="size-7" />
</a>
