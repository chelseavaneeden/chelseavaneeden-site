---
// Stripe's embeddable pricing table (plans + secure checkout, hosted by Stripe).
// The script only loads on pages that use this component.
interface Props {
  pricingTableId: string;
  publishableKey: string;
}

const { pricingTableId, publishableKey } = Astro.props;
---

<script is:inline async src="https://js.stripe.com/v3/pricing-table.js"></script>
<stripe-pricing-table pricing-table-id={pricingTableId} publishable-key={publishableKey}></stripe-pricing-table>
