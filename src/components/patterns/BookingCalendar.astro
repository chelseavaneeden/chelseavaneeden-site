---
// Chelsea's Google booking calendar (an appointment schedule), where clients pick a time and pay. It stays
// hidden, and nothing from Google loads, until someone presses a BookingButton with the same id; then it opens
// here and the page scrolls to it. That keeps the page fast and private until it's needed.
import { t } from '../../i18n/ui';
import { bookingEmbedUrl } from '../../lib/booking';

interface Props {
  /** The booking page address from Site settings → Intro session page. */
  url: string;
  /** Matches the `target` of the BookingButton that opens it. */
  id: string;
}

const { url, id } = Astro.props;
const embed = bookingEmbedUrl(url);
---

{/* Clean paper lifted above the page's film grain (like Card variant="paper"), so Google's white time slots
    and the box around them are one even colour. Google's page is see-through, so this colour shows through it. */}
<div
  id={id}
  class="relative z-(--z-paper) hidden h-(--booking-frame-h) w-full scroll-mt-(--header-h) overflow-hidden rounded-media bg-surface-paper shadow-raised"
  data-booking-frame
  data-embed={embed}
  data-title={t('en', 'booking.frameTitle')}
>
</div>

<script>
  type Umami = { track: (name: string, data?: Record<string, string>) => void };

  document.querySelectorAll<HTMLElement>('[data-booking-frame]').forEach((frame) => {
    const src = frame.dataset.embed;
    document.querySelectorAll<HTMLElement>(`[data-booking-open="${frame.id}"] a`).forEach((link) => {
      link.addEventListener('click', (event) => {
        (window as unknown as { umami?: Umami }).umami?.track('see_times', { page: location.pathname });
        if (!src) return; // No embed address: Google's page opens in a new tab.
        event.preventDefault();
        if (!frame.firstElementChild) {
          const iframe = document.createElement('iframe');
          iframe.src = src;
          iframe.title = frame.dataset.title ?? '';
          iframe.className = 'size-full border-0';
          frame.append(iframe);
        }
        frame.classList.remove('hidden');
        const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        frame.scrollIntoView({ behavior: reduce ? 'auto' : 'smooth', block: 'start' });
      });
    });
  });
</script>
