---
// The short proof line under the main buttons (Site settings → Trust line): a few facts.
// A fact's link opens in a new tab.
import Icon from '../ui/Icon.astro';
import type { Site } from '../../lib/content';

interface Props {
  trust: Site['trust'];
  class?: string;
}

const { trust, class: className } = Astro.props;
const entries = trust.items.map((i) => ({ ...i, icon: i.href?.includes('youtube.com') ? ('play' as const) : undefined }));
const external = (href?: string) => Boolean(href && /^https?:\/\//.test(href));
---

{
  entries.length > 0 && (
    <ul class:list={['flex flex-wrap items-center gap-x-5 gap-y-2', className]}>
      {entries.map((e) => (
        <li class="type-body-s inline-flex items-center gap-1.5 text-ink-muted">
          {e.icon && <Icon name={e.icon} class="text-base text-logo-mark" />}
          {e.href ? (
            <a
              href={e.href}
              target={external(e.href) ? '_blank' : undefined}
              rel={external(e.href) ? 'noopener' : undefined}
              data-track="trust_line"
              class="underline decoration-line decoration-1 underline-offset-4 transition-colors hover:text-ink hover:decoration-current"
            >
              {e.label}
            </a>
          ) : (
            e.label
          )}
        </li>
      ))}
    </ul>
  )
}
