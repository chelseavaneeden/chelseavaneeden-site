---
// Reviews as a row of cards, like a Google reviews widget but built into the site: a bar with the
// Google rating (Site settings → Google rating), then cards to scroll with the arrows or swipe.
// Long reviews show five lines and a Read more that opens them in place. Nothing links to Google,
// and there is no "Write a review" button, so people stay on the site.
import Icon from '../ui/Icon.astro';
import StarRating from '../ui/StarRating.astro';
import Text from '../ui/Text.astro';
import SectionHeader from './SectionHeader.astro';
import type { Testimonial } from '../../lib/content';

interface Props {
  eyebrow?: string;
  title: string;
  testimonials: Testimonial[];
  /** Your Google rating and number of reviews; the bar shows when both are set. */
  rating?: number;
  count?: number;
  /** Small line under the cards, e.g. Shared with each client's permission. */
  note?: string;
}

const { eyebrow, title, testimonials, rating, count, note } = Astro.props;
const initial = (name: string) => name.trim().charAt(0).toUpperCase();
const byline = (t: Testimonial) => [t.source === 'google' ? 'Google review' : t.context, t.date].filter(Boolean).join(' · ');
const arrow =
  'flex size-11 items-center justify-center rounded-pill border border-line bg-surface-raised text-xl text-ink transition-colors hover:border-ink disabled:cursor-default disabled:opacity-40 disabled:hover:border-line';
---

<div class="flex flex-col gap-8 md:gap-10" data-reviews>
  <div class="flex items-end justify-between gap-6">
    <SectionHeader eyebrow={eyebrow} title={title} />
    {
      testimonials.length > 1 && (
        <div class="hidden shrink-0 gap-2 md:flex" data-reviews-arrows>
          <button type="button" class={arrow} data-prev aria-label="Previous reviews">
            <Icon name="arrow-right" class="rotate-180" />
          </button>
          <button type="button" class={arrow} data-next aria-label="More reviews">
            <Icon name="arrow-right" />
          </button>
        </div>
      )
    }
  </div>

  {
    rating && count && (
      <p class="flex flex-wrap items-center gap-x-4 gap-y-2 rounded-card bg-surface-raised px-6 py-5 md:px-8">
        <span class="type-h3 text-ink">Google</span>
        <StarRating value={rating} class="text-xl" />
        <span class="type-body text-ink">
          <span class="font-medium">{rating.toFixed(1)}</span>
          <span class="px-2 text-ink-muted" aria-hidden="true">|</span>
          {count} review{count === 1 ? '' : 's'}
        </span>
      </p>
    )
  }

  <ul
    class="scrollbar-none -mx-(--gutter) flex snap-x snap-mandatory scroll-px-(--gutter) gap-4 overflow-x-auto px-(--gutter) md:mx-0 md:scroll-px-0 md:px-0"
    data-reviews-list
    aria-label="Reviews"
  >
    {
      testimonials.map((t) => (
        <li class="flex shrink-0 basis-4/5 snap-start md:basis-(--review-card-2) lg:basis-(--review-card-3)">
          <figure class="flex w-full flex-col gap-5 rounded-card bg-surface-raised p-6 md:p-7">
            <figcaption class="flex items-center gap-3">
              <span class="type-label flex size-11 shrink-0 items-center justify-center rounded-pill bg-surface-alt text-ink" aria-hidden="true">
                {initial(t.name)}
              </span>
              <span class="flex min-w-0 flex-col">
                <span class="type-label text-ink">{t.name}</span>
                {byline(t) && <span class="type-body-s text-ink-muted">{byline(t)}</span>}
              </span>
            </figcaption>
            {t.rating && <StarRating value={t.rating} class="text-lg" />}
            <div class="flex flex-col items-start gap-2">
              <blockquote class="type-body line-clamp-5 text-ink" data-review-text>
                {t.quote}
              </blockquote>
              <button type="button" class="type-body-s hidden text-ink-muted underline underline-offset-4 hover:text-ink" data-read-more aria-expanded="false">
                Read more
              </button>
            </div>
          </figure>
        </li>
      ))
    }
  </ul>

  {note && <Text variant="caption" tone="muted" text={note} />}
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-reviews]').forEach((block) => {
    const list = block.querySelector<HTMLElement>('[data-reviews-list]');
    const arrows = block.querySelector<HTMLElement>('[data-reviews-arrows]');
    const prev = block.querySelector<HTMLButtonElement>('[data-prev]');
    const next = block.querySelector<HTMLButtonElement>('[data-next]');
    if (!list) return;

    // Arrows: one card at a time; hidden when every card already fits.
    const step = () => {
      const card = list.querySelector<HTMLElement>('li');
      return card ? card.offsetWidth + parseFloat(getComputedStyle(list).columnGap || '0') : list.clientWidth;
    };
    const update = () => {
      const overflowing = list.scrollWidth > list.clientWidth + 1;
      arrows?.classList.toggle('md:flex', overflowing);
      if (prev) prev.disabled = list.scrollLeft <= 1;
      if (next) next.disabled = list.scrollLeft + list.clientWidth >= list.scrollWidth - 1;
    };
    prev?.addEventListener('click', () => list.scrollBy({ left: -step(), behavior: 'smooth' }));
    next?.addEventListener('click', () => list.scrollBy({ left: step(), behavior: 'smooth' }));
    list.addEventListener('scroll', update, { passive: true });

    // Read more: only on reviews longer than five lines; opens the text in place.
    const texts = [...block.querySelectorAll<HTMLElement>('[data-review-text]')];
    const measure = () => {
      texts.forEach((text) => {
        const button = text.nextElementSibling as HTMLButtonElement | null;
        if (!button || button.getAttribute('aria-expanded') === 'true') return;
        button.classList.toggle('hidden', text.scrollHeight <= text.clientHeight + 1);
      });
      update();
    };
    texts.forEach((text) => {
      const button = text.nextElementSibling as HTMLButtonElement | null;
      button?.addEventListener('click', () => {
        const open = button.getAttribute('aria-expanded') !== 'true';
        text.classList.toggle('line-clamp-5', !open);
        button.setAttribute('aria-expanded', String(open));
        button.textContent = open ? 'Read less' : 'Read more';
      });
    });

    measure();
    window.addEventListener('resize', measure);
    document.fonts?.ready.then(measure);
  });
</script>
