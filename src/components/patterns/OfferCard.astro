---
import Button from '../ui/Button.astro';
import Card from '../ui/Card.astro';
import Divider from '../ui/Divider.astro';
import Eyebrow from '../ui/Eyebrow.astro';
import Heading from '../ui/Heading.astro';
import Icon from '../ui/Icon.astro';
import Img from '../ui/Img.astro';
import Price from '../ui/Price.astro';
import Sunlight from '../ui/Sunlight.astro';
import Text from '../ui/Text.astro';
import type { Offer } from '../../lib/content';

interface Props {
  offer: Offer;
  /** Card style for non-featured offers; featured offers are the page's colour with the sunrise glow. */
  variant?: 'raised' | 'outline';
}

const { offer, variant = 'raised' } = Astro.props;

// With a photo, the photo sits on top on phones and on the left from tablets up.
const hasPhoto = Boolean(offer.image);
---

<Card
  as="article"
  variant={offer.featured ? 'sunrise' : variant}
  padding={hasPhoto ? 'none' : 'm'}
  class={hasPhoto ? 'h-full overflow-hidden md:flex-row' : 'h-full'}
>
  {
    offer.image && (
      <div class="relative shrink-0 md:w-1/3">
        <Img
          src={offer.image}
          alt={offer.imageAlt ?? ''}
          ratio="landscape"
          focus={offer.imageFocus}
          rounded={false}
          sizes="(min-width: 1280px) 20vw, (min-width: 768px) 33vw, 100vw"
          class="md:absolute md:inset-0 md:aspect-auto"
        />
      </div>
    )
  }
  {/* The featured card (the intro session) gets more room inside, so it stands a little taller. Its glow
      sits behind the words rather than the whole card, so the photo doesn't hide it on phones. */}
  <div class:list={['flex flex-1 flex-col gap-6', offer.featured && 'relative isolate', hasPhoto && (offer.featured ? 'px-6 py-10 sm:px-8 md:px-12 md:py-14' : 'p-7 md:p-8')]}>
    {offer.featured && <Sunlight contours={false} />}
    <div class="flex flex-col gap-3">
      {offer.eyebrow && <Eyebrow tone={offer.featured ? 'accent' : 'muted'}>{offer.eyebrow}</Eyebrow>}
      <Heading level={3} variant="h3" text={offer.title} class={offer.showTitle ? undefined : 'sr-only'} />
      {offer.summary && <Text variant={offer.featured ? 'body' : 'body-s'} tone="muted" text={offer.summary} />}
    </div>
    <div class="flex flex-col items-start gap-3">
      <Price offer={offer} />
      {offer.highlight && <p class="type-label rounded-pill bg-note px-3 py-1.5 text-note-ink">{offer.highlight}</p>}
    </div>
    <Divider />
    <ul class="flex flex-col gap-2.5">
      {
        offer.includes.map((item) => (
          <li class:list={[offer.featured ? 'type-body gap-3' : 'type-body-s gap-2.5', 'flex items-start text-ink']}>
            <Icon name="check" class="mt-1 shrink-0 text-accent" />
            {item}
          </li>
        ))
      }
    </ul>
    {/* The button is as wide as its words plus some breathing room, not the whole card. */}
    <div class="mt-auto pt-4">
      <Button
        href={offer.cta.href}
        variant={offer.featured ? 'primary' : 'secondary'}
        size={offer.featured ? 'l' : 'm'}
        external={/^https?:\/\//.test(offer.cta.href)}
        event="offer_card"
      >
        {offer.cta.label}
      </Button>
    </div>
  </div>
</Card>
