---
import Button from '../ui/Button.astro';
import Card from '../ui/Card.astro';
import Divider from '../ui/Divider.astro';
import Eyebrow from '../ui/Eyebrow.astro';
import Heading from '../ui/Heading.astro';
import Icon from '../ui/Icon.astro';
import Img from '../ui/Img.astro';
import Price from '../ui/Price.astro';
import Text from '../ui/Text.astro';
import type { Offer } from '../../lib/content';

interface Props {
  offer: Offer;
  /** Card style for non-featured offers; featured offers always use the inverse tone. */
  variant?: 'raised' | 'outline';
}

const { offer, variant = 'raised' } = Astro.props;

// With a photo, the photo sits on top on phones and on the left from tablets up.
const hasPhoto = Boolean(offer.image);
---

<Card
  as="article"
  variant={offer.featured ? 'inverse' : variant}
  padding={hasPhoto ? 'none' : 'm'}
  class={hasPhoto ? 'h-full overflow-hidden md:flex-row' : 'h-full'}
>
  {
    offer.image && (
      <div class="relative shrink-0 md:w-1/3">
        <Img
          src={offer.image}
          alt={offer.imageAlt ?? ''}
          ratio="landscape"
          focus={offer.imageFocus}
          rounded={false}
          sizes="(min-width: 1280px) 20vw, (min-width: 768px) 33vw, 100vw"
          class="md:absolute md:inset-0 md:aspect-auto"
        />
      </div>
    )
  }
  <div class:list={['flex flex-1 flex-col gap-6', hasPhoto && 'p-7 md:p-8']}>
    <div class="flex flex-col gap-3">
      {offer.eyebrow && <Eyebrow tone={offer.featured ? 'accent' : 'muted'}>{offer.eyebrow}</Eyebrow>}
      <Heading level={3} variant="h3" text={offer.title} class={offer.showTitle ? undefined : 'sr-only'} />
      {offer.summary && <Text variant="body-s" tone="muted" text={offer.summary} />}
    </div>
    <div class="flex flex-col items-start gap-3">
      <Price offer={offer} />
      {offer.highlight && <p class="type-label rounded-pill bg-note px-3 py-1.5 text-note-ink">{offer.highlight}</p>}
    </div>
    <Divider />
    <ul class="flex flex-col gap-2.5">
      {
        offer.includes.map((item) => (
          <li class="type-body-s flex items-start gap-2.5 text-ink">
            <Icon name="check" class="mt-0.5 text-lg text-accent" />
            {item}
          </li>
        ))
      }
    </ul>
    <div class="mt-auto pt-2">
      <Button
        href={offer.cta.href}
        variant={offer.featured ? 'primary' : 'secondary'}
        full
        external={/^https?:\/\//.test(offer.cta.href)}
        event="offer_card"
      >
        {offer.cta.label}
      </Button>
    </div>
  </div>
</Card>
