---
import Button from '../ui/Button.astro';
import Card from '../ui/Card.astro';
import Divider from '../ui/Divider.astro';
import Eyebrow from '../ui/Eyebrow.astro';
import Heading from '../ui/Heading.astro';
import Icon from '../ui/Icon.astro';
import Img from '../ui/Img.astro';
import Price from '../ui/Price.astro';
import Sunlight from '../ui/Sunlight.astro';
import Text from '../ui/Text.astro';
import { newTabRule, type Offer } from '../../lib/content';

interface Props {
  offer: Offer;
  /** Card style for non-featured offers; featured offers are the page's colour with the sunrise glow. */
  variant?: 'raised' | 'outline';
  /** Wide layout for a single card without a photo: name and price on the left, what's included and the button on
   *  the right (stacked on phones). It mirrors the intro session card, with words where its photo would be. */
  wide?: boolean;
}

const { offer, variant = 'raised', wide: wideProp = false } = Astro.props;
const newTab = await newTabRule();

// With a photo, the photo sits on top on phones and on the left from tablets up.
const hasPhoto = Boolean(offer.image);
const wide = wideProp && !hasPhoto;
---

<Card
  as="article"
  variant={offer.featured ? 'sunrise' : variant}
  padding={hasPhoto || wide ? 'none' : 'm'}
  class={hasPhoto ? 'h-full overflow-hidden md:flex-row' : wide ? 'h-full overflow-hidden' : 'h-full'}
>
  {
    offer.image && (
      <div class="relative shrink-0 md:w-1/3">
        <Img
          src={offer.image}
          alt={offer.imageAlt ?? ''}
          ratio="landscape"
          focus={offer.imageFocus}
          rounded={false}
          sizes="(min-width: 1280px) 20vw, (min-width: 768px) 33vw, 100vw"
          class="md:absolute md:inset-0 md:aspect-auto"
        />
      </div>
    )
  }
  {/* The featured card (the intro session) gets more room inside, so it stands a little taller. Its glow
      sits behind the words rather than the whole card, so the photo doesn't hide it on phones. */}
  <div
    class:list={[
      wide ? 'grid grid-cols-1 gap-6 md:grid-cols-2 md:gap-x-12 md:gap-y-8' : 'flex flex-1 flex-col gap-6',
      offer.featured && 'relative isolate',
      (hasPhoto || wide) && (offer.featured ? 'px-6 py-10 sm:px-8 md:px-12 md:py-14' : 'p-7 md:p-8'),
    ]}
  >
    {offer.featured && <Sunlight contours={false} />}
    <div class:list={['flex flex-col gap-6', wide && 'md:col-start-1 md:row-start-1']}>
      <div class="flex flex-col gap-3">
        {offer.eyebrow && <Eyebrow tone={offer.featured ? 'accent' : 'muted'}>{offer.eyebrow}</Eyebrow>}
        <Heading level={3} variant="h3" text={offer.title} class={offer.showTitle ? undefined : 'sr-only'} />
        {/* With the title hidden, the line under it leads the card, so it reads a size up and in full colour. */}
        {offer.summary && (
          <Text
            variant={!offer.showTitle && wide ? 'lede' : offer.featured ? 'body' : 'body-s'}
            tone={!offer.showTitle && wide ? 'ink' : 'muted'}
            text={offer.summary}
          />
        )}
      </div>
      <div class="flex flex-col items-start gap-3">
        <Price offer={offer} />
        {offer.highlight && <p class="type-label rounded-pill bg-note px-3 py-1.5 text-note-ink">{offer.highlight}</p>}
      </div>
    </div>
    <div class:list={['flex flex-1 flex-col gap-6', wide && 'border-t border-line pt-6 md:col-start-2 md:row-span-2 md:row-start-1 md:border-t-0 md:border-l md:pt-0 md:pl-12']}>
      {!wide && <Divider />}
      <ul class="flex flex-col gap-2.5">
        {
          offer.includes.map((item) => (
            <li class:list={[offer.featured ? 'type-body gap-3' : 'type-body-s gap-2.5', 'flex items-start text-ink']}>
              <Icon name="check" class="mt-1 shrink-0 text-accent" />
              {item}
            </li>
          ))
        }
      </ul>
      {/* The button is as wide as its words plus some breathing room, not the whole card. */}
      {
        !wide && (
          <div class="mt-auto pt-4">
            <Button href={offer.cta.href} variant={offer.featured ? 'primary' : 'secondary'} size={offer.featured ? 'l' : 'm'} external={newTab(offer.cta.href)} event="offer_card">
              {offer.cta.label}
            </Button>
          </div>
        )
      }
    </div>
    {/* In the wide card the button sits under the price on wide screens, so the two columns balance, and comes last on
        phones, after what's included. */}
    {
      wide && (
        <div class="md:col-start-1 md:row-start-2 md:self-end">
          <Button href={offer.cta.href} variant={offer.featured ? 'primary' : 'secondary'} size={offer.featured ? 'l' : 'm'} external={newTab(offer.cta.href)} event="offer_card">
            {offer.cta.label}
          </Button>
        </div>
      )
    }
  </div>
</Card>
