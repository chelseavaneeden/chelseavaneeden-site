---
// A short numbered row of one-line steps, e.g. what happens after paying. The steps sit side by side
// from tablets up and stack on phones, where three columns would be too narrow to read.
interface Props {
  items: string[];
  class?: string;
}

const { items, class: className } = Astro.props;
---

<ol class:list={['grid grid-cols-1 gap-4 md:grid-cols-3 md:gap-8', className]}>
  {
    items.map((item, i) => (
      <li class="flex items-center gap-4">
        <span class="type-label inline-flex size-9 shrink-0 items-center justify-center rounded-pill border border-line text-ink" aria-hidden="true">
          {i + 1}
        </span>
        <span class="type-body text-ink">{item}</span>
      </li>
    ))
  }
</ol>
