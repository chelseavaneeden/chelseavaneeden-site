---
import Eyebrow from '../ui/Eyebrow.astro';
import Heading from '../ui/Heading.astro';
import Text from '../ui/Text.astro';

interface Props {
  eyebrow?: string;
  title: string;
  intro?: string;
  /** stacked: everything in one column. split: title left, intro right (wide screens). */
  layout?: 'stacked' | 'split' | 'centered';
  id?: string;
  /** Stacked only: the title grows across the screen and settles as the section scrolls in (ScrollGrow). */
  grow?: boolean;
}

const { eyebrow, title, intro, layout = 'stacked', id, grow = false } = Astro.props;
---

{
  layout === 'split' ? (
    <div data-reveal class="grid grid-cols-1 gap-6 lg:grid-cols-12 lg:items-end">
      <div class="flex flex-col gap-4 lg:col-span-7">
        {eyebrow && <Eyebrow>{eyebrow}</Eyebrow>}
        <Heading variant="h1" text={title} id={id} />
      </div>
      {intro && <Text tone="muted" class="lg:col-span-5" text={intro} />}
    </div>
  ) : (
    <div data-reveal={grow ? undefined : true} class:list={['flex max-w-narrow flex-col gap-4', layout === 'centered' && 'mx-auto items-center text-center']}>
      {eyebrow && <Eyebrow>{eyebrow}</Eyebrow>}
      {grow ? (
        <div data-grow-heading class="w-fit">
          <Heading variant="h1" text={title} id={id} />
        </div>
      ) : (
        <Heading variant="h1" text={title} id={id} />
      )}
      {intro && (grow ? <div data-grow-follow><Text tone="muted" class="max-w-prose" text={intro} /></div> : <Text tone="muted" class="max-w-prose" text={intro} />)}
    </div>
  )
}
