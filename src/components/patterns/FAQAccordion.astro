---
import Button from '../ui/Button.astro';
import Icon from '../ui/Icon.astro';
import Text from '../ui/Text.astro';
import SectionHeader from './SectionHeader.astro';

interface Props {
  eyebrow?: string;
  title: string;
  intro?: string;
  items: { question: string; answer: string }[];
  /** Optional outlined button under the questions, e.g. Ask me a question (/enquire opens the pop-up). */
  link?: { label: string; href: string };
}

const { eyebrow, title, intro, items, link } = Astro.props;
// Answers are plain text; a blank line in the editor starts a new paragraph.
const paragraphs = (answer: string) => answer.split(/\n\s*\n/).map((p) => p.trim()).filter(Boolean);
---

<div class="grid grid-cols-1 gap-10 lg:grid-cols-12 lg:gap-16">
  <div class="lg:col-span-4">
    <SectionHeader eyebrow={eyebrow} title={title} intro={intro} />
  </div>
  <div class="flex flex-col items-start gap-10 lg:col-span-8">
    <div class="w-full border-b border-line">
      {
        items.map((item) => (
          <details class="group/faq border-t border-line">
            <summary class="flex cursor-pointer items-start justify-between gap-6 py-6">
              <span class="type-h3 text-heading">{item.question}</span>
              <span class="mt-1 text-xl text-ink transition-transform duration-(--duration-base) ease-soft group-open/faq:rotate-45">
                <Icon name="plus" />
              </span>
            </summary>
            <div class="flex max-w-prose flex-col gap-3 pb-7">
              {paragraphs(item.answer).map((p) => (
                <Text tone="muted" text={p} />
              ))}
            </div>
          </details>
        ))
      }
    </div>
    {
      link && (
        <Button href={link.href} size="l" variant="secondary" event="faq">
          {link.label}
        </Button>
      )
    }
  </div>
</div>
