---
import Container, { type ContainerWidth } from './Container.astro';

export type SectionTone = 'light' | 'alt' | 'dark';
export type SectionSpace = 'none' | 's' | 'm' | 'l';

interface Props {
  tone?: SectionTone;
  space?: SectionSpace;
  width?: ContainerWidth;
  /** Tinted (alt) sections only: a light, faded sage instead of the page's own tint. */
  tint?: 'sage';
  /** Skip the inner container (for full-bleed layouts that manage their own width). */
  bare?: boolean;
  id?: string;
  labelledby?: string;
  class?: string;
}

const {
  tone = 'light',
  space = 'm',
  width = 'content',
  tint,
  bare = false,
  id,
  labelledby,
  class: className,
} = Astro.props;

const spaces: Record<SectionSpace, string> = {
  none: '',
  s: 'py-(--space-section-s)',
  m: 'py-(--space-section-m)',
  l: 'py-(--space-section-l)',
};
---

<section
  id={id}
  aria-labelledby={labelledby}
  data-tone={tone}
  data-tint={tint}
  class:list={[spaces[space], className]}
>
  {
    bare ? (
      <slot />
    ) : (
      <Container width={width}>
        <slot />
      </Container>
    )
  }
</section>
