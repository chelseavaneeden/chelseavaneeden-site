---
export type ContainerWidth = 'prose' | 'narrow' | 'content' | 'wide' | 'full';

interface Props {
  width?: ContainerWidth;
  class?: string;
  /** Fade the container in as it scrolls into view (see global.css). */
  'data-reveal'?: boolean;
}

const { width = 'content', class: className, ...rest } = Astro.props;

const widths: Record<ContainerWidth, string> = {
  prose: 'max-w-prose',
  narrow: 'max-w-narrow',
  content: 'max-w-content',
  wide: 'max-w-wide',
  full: 'max-w-none',
};
---

<div {...rest} class:list={['mx-auto w-full px-(--gutter)', widths[width], className]}>
  <slot />
</div>
