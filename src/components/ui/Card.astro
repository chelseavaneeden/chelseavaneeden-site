---
export type CardVariant = 'raised' | 'outline' | 'plain' | 'sunrise' | 'paper';
export type CardPadding = 'none' | 's' | 'm' | 'l';

interface Props {
  variant?: CardVariant;
  padding?: CardPadding;
  as?: 'div' | 'article' | 'li' | 'a';
  href?: string;
  class?: string;
}

const { variant = 'raised', padding = 'm', as = 'div', href, class: className } = Astro.props;

const Tag = href ? 'a' : as;
const variants: Record<CardVariant, string> = {
  raised: 'bg-surface-raised shadow-raised',
  outline: 'border border-line',
  plain: '',
  // The page's own colour; put a <Sunlight contours={false} /> inside for the header's sunrise glow.
  sunrise: 'relative isolate overflow-hidden bg-surface shadow-raised',
  // For forms: clean warm paper lifted above the page's film grain, so the words read crisply.
  // It only clears the grain where no parent makes its own layer (no isolate, transform or opacity around it).
  paper: 'relative z-(--z-paper) bg-surface-paper shadow-raised',
};
const paddings: Record<CardPadding, string> = { none: '', s: 'p-5', m: 'p-7 md:p-8', l: 'p-8 md:p-12' };
---

<Tag href={href} class:list={['rounded-card flex flex-col', variants[variant], paddings[padding], className]}>
  <slot />
</Tag>
