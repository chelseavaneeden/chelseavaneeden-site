---
// Headings that grow across the screen and settle as their section scrolls in (Hi, I'm Chelsea and
// What clients notice). Mark the section with data-grow-section, wrap its heading in an element with
// data-grow-heading (sized to the words, e.g. class="w-fit"), and mark what should wait for the
// heading with data-grow-follow. The heading starts as wide as the page, from the page's left edge,
// and eases into its place; the followers fade in once it has settled. Driven by scrolling, so it
// follows the visitor's pace in both directions. Skipped for people who prefer reduced motion
// (everything simply shows in place). Included once, in Base. Styles in global.css ([data-grow-…]).
---

<script>
  type Grow = { section: HTMLElement; wrap: HTMLElement; heading: HTMLElement; startScale: number; startShift: number };

  const pageEdge = document.querySelector<HTMLElement>('[data-site-header] > div');
  const grows: Grow[] = [];
  document.querySelectorAll<HTMLElement>('[data-grow-section]').forEach((section) => {
    const wrap = section.querySelector<HTMLElement>('[data-grow-heading]');
    const heading = wrap?.firstElementChild as HTMLElement | null | undefined;
    if (wrap && heading) grows.push({ section, wrap, heading, startScale: 1, startShift: 0 });
  });

  if (pageEdge && grows.length && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    let frame = 0;
    const clamp = (n: number) => Math.min(1, Math.max(0, n));
    // Slow at both ends: it lingers wide, then eases gently into place.
    const ease = (t: number) => t * t * (3 - 2 * t);

    const update = () => {
      frame = 0;
      grows.forEach((g) => {
        // 0 when the heading's column reaches the bottom of the screen, 1 when it is 30% from the top.
        const top = (g.wrap.parentElement ?? g.wrap).getBoundingClientRect().top;
        const progress = clamp((innerHeight - top) / (innerHeight * 0.7));
        const settle = ease(progress);
        g.section.style.setProperty('--grow-scale', String(g.startScale + (1 - g.startScale) * settle));
        g.section.style.setProperty('--grow-x', `${g.startShift * (1 - settle)}px`);
        g.section.style.setProperty('--grow-follow', String(clamp((progress - 0.7) / 0.3)));
      });
    };

    // How big each heading starts: as wide as the page, from the page's left edge.
    const measure = () => {
      const edge = pageEdge.getBoundingClientRect();
      const padding = parseFloat(getComputedStyle(pageEdge).paddingLeft);
      const available = edge.width - padding * 2;
      grows.forEach((g) => {
        g.section.style.setProperty('--grow-scale', '1');
        g.section.style.setProperty('--grow-x', '0px');
        const range = document.createRange();
        range.selectNodeContents(g.heading);
        const text = range.getBoundingClientRect();
        g.startScale = Math.max(1, available / text.width);
        g.startShift = edge.left + padding - text.left;
      });
      update();
    };

    grows.forEach((g) => (g.section.dataset.grow = 'on'));
    addEventListener('scroll', () => {
      if (!frame) frame = requestAnimationFrame(update);
    }, { passive: true });
    addEventListener('resize', measure);
    document.fonts?.ready.then(measure);
    measure();
  }
</script>
