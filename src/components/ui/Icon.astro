---
// Line icons drawn at 24px on a 1.5 stroke; they inherit the text colour.
export type IconName = 'arrow-right' | 'arrow-up-right' | 'check' | 'plus' | 'menu' | 'close' | 'chevron-down' | 'message';

interface Props {
  name: IconName;
  label?: string;
  class?: string;
}

const { name, label, class: className } = Astro.props;

const paths: Record<IconName, string> = {
  'arrow-right': 'M4 12h15M13 6l6 6-6 6',
  'arrow-up-right': 'M7 17 17 7M8 7h9v9',
  check: 'm5 12.5 4.5 4.5L19 7.5',
  plus: 'M12 5v14M5 12h14',
  menu: 'M4 8h16M4 16h16',
  close: 'M6 6l12 12M18 6 6 18',
  'chevron-down': 'm6 9 6 6 6-6',
  message: 'M20.5 11.5a8.5 8.5 0 0 1-12.3 7.6L3.5 20.5l1.4-4.5a8.5 8.5 0 1 1 15.6-4.5Z',
};
---

<svg
  class:list={['shrink-0', className]}
  width="1em"
  height="1em"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
>
  <path d={paths[name]}></path>
</svg>
