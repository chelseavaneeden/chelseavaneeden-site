---
// Orbs of sunlight, like light caught in a camera lens on a bright morning: soft discs that rise a
// little and glow brighter, then settle, each at its own pace. Put it inside an element with
// `relative isolate overflow-hidden`; it sits behind the content and is hidden from screen readers.
// Still for people who prefer reduced motion (data-ambient, see global.css).
interface Props {
  /** light: honey orbs for linen and sage sections. dusk: brighter orbs for the moss panels. */
  tone?: 'light' | 'dusk';
  /** How many orbs (up to 8). Tinted sections use a few; the header and closing panel use more. */
  count?: number;
  class?: string;
}

const { tone = 'light', count = 8, class: className } = Astro.props;
const orbs = Array.from({ length: Math.min(count, 8) }, (_, i) => i + 1);
---

<div class:list={['light-orbs pointer-events-none absolute inset-0 -z-10 overflow-hidden', `light-orbs-${tone}`, className]} aria-hidden="true">
  {orbs.map((n) => <span class:list={['light-orb absolute', `light-orb-${n}`]} data-ambient></span>)}
</div>

<style>
  .light-orb {
    aspect-ratio: 1;
    border-radius: 50%;
    background-image: var(--orb-light);
    animation: float var(--duration-float) var(--ease-in-out-soft) infinite;
  }

  .light-orbs-dusk .light-orb {
    background-image: var(--orb-dusk);
  }

  /* Scattered sizes, places and timings, so they never move in step. */
  .light-orb-1 {
    width: 7rem;
    left: 8%;
    top: 18%;
  }
  .light-orb-2 {
    width: 3.5rem;
    left: 22%;
    top: 62%;
    animation-delay: -4s;
    animation-duration: calc(var(--duration-float) * 1.3);
  }
  .light-orb-3 {
    width: 10rem;
    right: 12%;
    top: 8%;
    animation-delay: -9s;
    animation-duration: calc(var(--duration-float) * 1.6);
  }
  .light-orb-4 {
    width: 2.5rem;
    right: 28%;
    top: 46%;
    animation-delay: -2s;
    animation-duration: calc(var(--duration-float) * 0.8);
  }
  .light-orb-5 {
    width: 5rem;
    left: 46%;
    bottom: 10%;
    animation-delay: -12s;
    animation-duration: calc(var(--duration-float) * 1.15);
  }
  .light-orb-6 {
    width: 4rem;
    right: 6%;
    bottom: 22%;
    animation-delay: -7s;
    animation-duration: calc(var(--duration-float) * 1.45);
  }
  .light-orb-7 {
    width: 2rem;
    left: 36%;
    top: 14%;
    animation-delay: -5s;
    animation-duration: calc(var(--duration-float) * 0.9);
  }
  .light-orb-8 {
    width: 6rem;
    left: 62%;
    top: 30%;
    animation-delay: -14s;
    animation-duration: calc(var(--duration-float) * 1.7);
  }
</style>
