---
// Five filled stars for a rating out of 5, in the star colour (--rating-star); empty stars use the line colour.
interface Props {
  value: number;
  class?: string;
}

const { value, class: className } = Astro.props;
const filled = Math.round(value);
const star = 'M12 2.8l2.83 5.73 6.32.92-4.57 4.46 1.08 6.3L12 17.24l-5.66 2.97 1.08-6.3L2.85 9.45l6.32-.92Z';
---

<span role="img" aria-label={`${value} out of 5 stars`} class:list={['inline-flex shrink-0 gap-0.5', className]}>
  {
    Array.from({ length: 5 }, (_, i) => (
      <svg width="1em" height="1em" viewBox="0 0 24 24" aria-hidden="true" class={i < filled ? 'text-rating-star' : 'text-line'}>
        <path d={star} fill="currentColor" />
      </svg>
    ))
  }
</span>
