---
/*
 * Chelsea's logo, from the existing brand artwork (public/brand/): the full signature, swoosh plus the
 * "helsea" script. The artwork is used as masks, so its colour comes from the --logo-mark token.
 */
export type LogoSize = 's' | 'm' | 'l';

interface Props {
  size?: LogoSize;
  /** Accessible name; the artwork itself reads "Chelsea". */
  label?: string;
  class?: string;
}

const { size = 'm', label = 'Chelsea van Eeden', class: className } = Astro.props;

const heights: Record<LogoSize, string> = {
  s: 'h-(--logo-height-s)',
  m: 'h-(--logo-height-m)',
  l: 'h-(--logo-height-l)',
};
---

<span role="img" aria-label={label} class:list={['logo relative inline-block aspect-82/36 text-logo-mark', heights[size], className]}>
  <span class="logo-mark absolute inset-0 bg-logo-mark" aria-hidden="true"></span>
  <span class="logo-word absolute inset-0 bg-current" aria-hidden="true"></span>
</span>

<style>
  .logo-mark,
  .logo-word {
    mask-repeat: no-repeat;
    mask-size: contain;
    mask-position: left center;
  }
  .logo-mark {
    mask-image: url('/brand/logo-mark.svg');
  }
  .logo-word {
    mask-image: url('/brand/logo-word.svg');
  }
</style>
