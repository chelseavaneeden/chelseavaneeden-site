---
/*
 * Chelsea's logo, from the existing brand artwork (public/brand/).
 *
 * seal (default): the swoosh alone, embossed on a round paper disc.
 * signature: the full signature, swoosh plus the "helsea" script.
 *
 * The artwork is used as masks, so its colours come from tokens: the swoosh uses --logo-mark
 * (ochre, lighter on dark tones) and the script uses the text colour.
 */
export type LogoSize = 's' | 'm' | 'l';
export type LogoVariant = 'seal' | 'signature';

interface Props {
  variant?: LogoVariant;
  size?: LogoSize;
  /** Accessible name; the artwork itself reads "Chelsea". */
  label?: string;
  class?: string;
}

const { variant = 'seal', size = 'm', label = 'Chelsea van Eeden', class: className } = Astro.props;

const heights: Record<LogoSize, string> = {
  s: 'h-(--logo-height-s)',
  m: 'h-(--logo-height-m)',
  l: 'h-(--logo-height-l)',
};
const seals: Record<LogoSize, string> = {
  s: 'size-(--logo-seal-s)',
  m: 'size-(--logo-seal-m)',
  l: 'size-(--logo-seal-l)',
};
---

{
  variant === 'seal' ? (
    <span role="img" aria-label={label} class:list={['logo-seal relative inline-block shrink-0 rounded-pill', seals[size], className]}>
      <span class="logo-emboss absolute inset-1/8" aria-hidden="true">
        <span class="logo-swoosh absolute inset-0 bg-logo-mark" />
      </span>
    </span>
  ) : (
    <span role="img" aria-label={label} class:list={['logo relative inline-block aspect-82/36 text-ink', heights[size], className]}>
      <span class="logo-mark absolute inset-0 bg-logo-mark" aria-hidden="true" />
      <span class="logo-word absolute inset-0 bg-current" aria-hidden="true" />
    </span>
  )
}

<style>
  .logo-mark,
  .logo-word,
  .logo-swoosh {
    mask-repeat: no-repeat;
    mask-size: contain;
    mask-position: left center;
  }
  .logo-mark {
    mask-image: url('/brand/logo-mark.svg');
  }
  .logo-word {
    mask-image: url('/brand/logo-word.svg');
  }

  /* Seal: a paper disc, lit from the top left. */
  .logo-seal {
    background: radial-gradient(circle at 35% 30%, var(--surface-raised), var(--surface-alt));
    box-shadow: var(--seal-shadow-value);
  }
  .logo-swoosh {
    mask-image: url('/brand/logo-mark-square.svg');
    mask-position: center;
  }
  /* The emboss sits on a wrapper because a filter on the masked element itself would be masked away. */
  .logo-emboss {
    filter: var(--emboss-filter);
  }
</style>
