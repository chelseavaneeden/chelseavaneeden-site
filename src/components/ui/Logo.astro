---
/*
 * Chelsea's logo, from the existing brand artwork (public/brand/).
 *
 * emboss (default): the swoosh alone, blind-embossed. It takes the colour of the section it
 * sits on and shows through light and shadow, so it adapts to every background.
 * signature: the full signature, swoosh plus the "helsea" script.
 *
 * The artwork is used as masks, so its colours come from tokens: the signature's swoosh uses
 * --logo-mark (ochre, lighter on dark tones) and the script uses the text colour.
 */
export type LogoSize = 's' | 'm' | 'l';
export type LogoVariant = 'emboss' | 'signature';

interface Props {
  variant?: LogoVariant;
  size?: LogoSize;
  /** Accessible name; the artwork itself reads "Chelsea". */
  label?: string;
  class?: string;
}

const { variant = 'emboss', size = 'm', label = 'Chelsea van Eeden', class: className } = Astro.props;

const heights: Record<LogoSize, string> = {
  s: 'h-(--logo-height-s)',
  m: 'h-(--logo-height-m)',
  l: 'h-(--logo-height-l)',
};
const embossSizes: Record<LogoSize, string> = {
  s: 'size-(--logo-emboss-s)',
  m: 'size-(--logo-emboss-m)',
  l: 'size-(--logo-emboss-l)',
};
---

{
  variant === 'emboss' ? (
    <span role="img" aria-label={label} class:list={['logo-emboss relative inline-block shrink-0', embossSizes[size], className]}>
      <span class="logo-swoosh absolute inset-0 bg-surface" aria-hidden="true" />
    </span>
  ) : (
    <span role="img" aria-label={label} class:list={['logo relative inline-block aspect-82/36 text-ink', heights[size], className]}>
      <span class="logo-mark absolute inset-0 bg-logo-mark" aria-hidden="true" />
      <span class="logo-word absolute inset-0 bg-current" aria-hidden="true" />
    </span>
  )
}

<style>
  .logo-mark,
  .logo-word,
  .logo-swoosh {
    mask-repeat: no-repeat;
    mask-size: contain;
    mask-position: left center;
  }
  .logo-mark {
    mask-image: url('/brand/logo-mark.svg');
  }
  .logo-word {
    mask-image: url('/brand/logo-word.svg');
  }
  .logo-swoosh {
    mask-image: url('/brand/logo-mark-square.svg');
    mask-position: center;
  }
  /* The emboss sits on the outer element because a filter on the masked element itself
     would be masked away. */
  .logo-emboss {
    filter: var(--emboss-filter);
  }
</style>
