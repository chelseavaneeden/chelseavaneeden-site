---
// Decorative light for a section: golden morning light from the top right, soft sun rays that slowly
// brighten and shift, and fine contour lines breathing in the bottom left corner. Put it inside an
// element with `relative isolate overflow-hidden`; it sits behind the content and is hidden from screen
// readers. The movement stops for people who prefer reduced motion (data-ambient, see global.css).
import Topography from './Topography.astro';

interface Props {
  /** Leave out the contour lines, e.g. for just the glow inside a card. */
  contours?: boolean;
  class?: string;
}

const { contours = true, class: className } = Astro.props;
---

<div class:list={['sunlight pointer-events-none absolute inset-0 -z-10 overflow-hidden', className]} aria-hidden="true">
  {/* Without contours it sits inside a card (--glow-sunrise-card). */}
  <div class:list={['sunlight-glow absolute inset-0', !contours && 'sunlight-glow-card']}></div>
  <div class="sunlight-rays absolute" data-ambient></div>
  {contours && <Topography />}
</div>

<style>
  .sunlight {
    -webkit-mask-image: var(--fade-bottom-mask);
    mask-image: var(--fade-bottom-mask);
  }

  .sunlight-glow {
    background-image: var(--glow-sunrise);
  }

  .sunlight-glow-card {
    background-image: var(--glow-sunrise-card);
  }

  .sunlight-rays {
    inset: -25% -15% -10% -10%;
    background-image: var(--sun-rays);
    -webkit-mask-image: var(--sun-rays-mask);
    mask-image: var(--sun-rays-mask);
    filter: blur(5px);
    animation: breathe var(--duration-breathe) var(--ease-in-out-soft) infinite;
  }
</style>
