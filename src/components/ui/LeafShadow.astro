---
// The soft shadow of a leafy branch, as if a tree outside the window casts it on a wall in morning
// sun. It sways gently. Put it inside an element with `relative overflow-hidden`; `placement` picks
// where it falls and how big it is. Hidden from screen readers, and still for people who prefer
// reduced motion (data-ambient, see global.css).
interface Props {
  /**
   * wall: small, top right of the intro card (lower down on phones, below the photo).
   * hero: larger, in the top right corner of the header.
   * section: medium, in the top right corner of a tinted section.
   */
  placement?: 'wall' | 'hero' | 'section';
}

const { placement = 'wall' } = Astro.props;

// A branch reaching in from the top right corner, with leaves on alternating sides.
const branch = { x0: 640, y0: -20, cx: 470, cy: 120, x1: 250, y1: 300 };
const point = (t: number) => {
  const u = 1 - t;
  return {
    x: u * u * branch.x0 + 2 * u * t * branch.cx + t * t * branch.x1,
    y: u * u * branch.y0 + 2 * u * t * branch.cy + t * t * branch.y1,
    // Direction of the branch at this point, in degrees.
    angle:
      (Math.atan2(2 * u * (branch.cy - branch.y0) + 2 * t * (branch.y1 - branch.cy), 2 * u * (branch.cx - branch.x0) + 2 * t * (branch.x1 - branch.cx)) *
        180) /
      Math.PI,
  };
};
const leaves = Array.from({ length: 13 }, (_, i) => {
  const t = 0.08 + i * 0.07;
  const p = point(t);
  const side = i % 2 === 0 ? 1 : -1;
  const angle = p.angle + side * 48;
  const length = 46 - i * 1.6;
  const rad = (angle * Math.PI) / 180;
  return {
    cx: (p.x + Math.cos(rad) * length * 0.9).toFixed(1),
    cy: (p.y + Math.sin(rad) * length * 0.9).toFixed(1),
    rx: length.toFixed(1),
    ry: (length * 0.36).toFixed(1),
    angle: angle.toFixed(1),
  };
});
const branchPath = `M${branch.x0} ${branch.y0} Q${branch.cx} ${branch.cy} ${branch.x1} ${branch.y1}`;
---

<svg
  class:list={['leaf-shadow pointer-events-none absolute', `leaf-shadow-${placement}`]}
  viewBox="0 0 600 400"
  preserveAspectRatio="xMaxYMin slice"
  aria-hidden="true"
  data-ambient
>
  <path class="leaf-shadow-branch" d={branchPath} />
  {leaves.map((l) => <ellipse cx={l.cx} cy={l.cy} rx={l.rx} ry={l.ry} transform={`rotate(${l.angle} ${l.cx} ${l.cy})`} />)}
</svg>

<style>
  .leaf-shadow {
    fill: var(--wall-shadow);
    mix-blend-mode: multiply;
    transform-origin: 100% 0%;
    animation: leaf-sway calc(var(--duration-breathe) * 0.9) var(--ease-in-out-soft) infinite;
  }

  .leaf-shadow-branch {
    fill: none;
    stroke: var(--wall-shadow);
    stroke-width: 7;
    stroke-linecap: round;
  }

  /* A small branch in the top right corner of the intro card, soft and in the background. */
  .leaf-shadow-wall {
    inset: -6% -4% 42% 58%;
    width: auto;
    height: auto;
    filter: blur(7px);
    opacity: 0.26;
  }

  /* On phones the photo sits on top of the card, so the shadow falls just below it, on the right. */
  @media (max-width: 767px) {
    .leaf-shadow-wall {
      inset: 42% -10% 28% 40%;
    }
  }

  /* A larger branch across the top right of the header, as if a tree stands just outside. */
  .leaf-shadow-hero {
    top: -4%;
    right: -4%;
    width: clamp(22rem, 46vw, 46rem);
    aspect-ratio: 3 / 2;
    filter: blur(10px);
    opacity: 0.2;
  }

  /* A branch in the top right corner of a tinted section. */
  .leaf-shadow-section {
    top: 0;
    right: -2%;
    width: clamp(16rem, 32vw, 30rem);
    aspect-ratio: 3 / 2;
    filter: blur(9px);
    opacity: 0.16;
  }
</style>
