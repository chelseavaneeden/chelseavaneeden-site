---
import ButtonSparks from './ButtonSparks.astro';
import Icon, { type IconName } from './Icon.astro';

export type ButtonVariant = 'primary' | 'secondary' | 'ghost' | 'link';
export type ButtonSize = 's' | 'm' | 'l';

interface Props {
  variant?: ButtonVariant;
  size?: ButtonSize;
  href?: string;
  type?: 'button' | 'submit';
  icon?: IconName;
  external?: boolean;
  full?: boolean;
  /** Pops on hover without the tilt, for wide buttons such as the form's send button. */
  still?: boolean;
  disabled?: boolean;
  /** Where this button is, for analytics, e.g. "hero". What it does is worked out from the link (see Base). */
  event?: string;
  class?: string;
}

const {
  variant = 'primary',
  size = 'm',
  href,
  type = 'button',
  icon,
  external = false,
  full = false,
  still = false,
  disabled = false,
  event,
  class: className,
} = Astro.props;

const base =
  'group/button inline-flex items-center justify-center gap-2 whitespace-nowrap transition duration-(--duration-base) ease-soft';

const variants: Record<ButtonVariant, string> = {
  primary:
    'rounded-pill bg-cta text-cta-ink hover:bg-cta-hover hover:shadow-glow disabled:cursor-not-allowed disabled:opacity-45 disabled:hover:bg-cta disabled:hover:shadow-none',
  secondary: 'rounded-pill border border-current text-ink hover:bg-ink hover:text-surface hover:border-ink',
  ghost: 'rounded-pill text-ink hover:bg-surface-alt',
  link: 'text-ink underline decoration-1 underline-offset-4 hover:decoration-2',
};

const sizes: Record<ButtonSize, string> = {
  s: 'type-label px-5 py-2.5',
  m: 'type-button px-7 py-3.5',
  // A little less padding on phones, so long labels fit inside cards.
  l: 'type-button px-6 py-4.5 sm:px-9',
};

// Main and outlined buttons lift, tilt and sparkle on hover (see global.css).
const pops = variant === 'primary' || variant === 'secondary';

const classes = [
  base,
  pops && 'button-pop',
  variants[variant],
  variant === 'link' ? 'type-label' : sizes[size],
  full && 'w-full',
  className,
];

const trailingIcon = icon ?? (external ? 'arrow-up-right' : undefined);
---

{
  href ? (
    <a
      href={href}
      class:list={classes}
      data-track={event}
      data-still={still || undefined}
      target={external ? '_blank' : undefined}
      rel={external ? 'noopener' : undefined}
    >
      {pops && <ButtonSparks />}
      <span data-button-label><slot /></span>
      {trailingIcon && (
        <Icon name={trailingIcon} class="transition-transform duration-(--duration-base) ease-soft group-hover/button:translate-x-0.5" />
      )}
    </a>
  ) : (
    <button type={type} class:list={classes} data-track={event} data-still={still || undefined} disabled={disabled}>
      {pops && <ButtonSparks />}
      <span data-button-label><slot /></span>
      {trailingIcon && <Icon name={trailingIcon} />}
    </button>
  )
}
