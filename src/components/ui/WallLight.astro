---
// The surface of a card made to feel like a sand-coloured wall in morning sun: a soft beam of window
// light falls across it and slowly brightens, the shadow of a leafy branch sways over it, and the
// plaster has a fine grain. Use inside a Card with variant="wall" (which is `relative isolate
// overflow-hidden`); it sits behind the content and is hidden from screen readers. The movement stops
// for people who prefer reduced motion (data-ambient, see global.css).
import LeafShadow from './LeafShadow.astro';
---

<div class="wall-light pointer-events-none absolute inset-0 -z-10 overflow-hidden" aria-hidden="true">
  <div class="wall-sun absolute" data-ambient></div>
  <LeafShadow placement="wall" />
  <div class="wall-grain absolute inset-0"></div>
</div>

<style>
  .wall-sun {
    inset: -15%;
    background-image: var(--wall-sun), var(--wall-glow);
    animation: breathe calc(var(--duration-breathe) * 1.3) var(--ease-in-out-soft) infinite;
  }

  .wall-grain {
    background-image: var(--grain-image);
    background-size: var(--grain-size);
    opacity: var(--wall-grain-opacity);
    mix-blend-mode: multiply;
  }
</style>
