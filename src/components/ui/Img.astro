---
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

export type ImgRatio = 'portrait' | 'tall' | 'landscape' | 'wide' | 'square' | 'fill';
import { focusClass, type Focus } from '../../lib/focus';

export type ImgFocus = Focus;

interface Props {
  src: ImageMetadata;
  alt: string;
  ratio?: ImgRatio;
  /** Rendered widths for the browser to choose from. */
  widths?: number[];
  sizes?: string;
  priority?: boolean;
  /** Which part of the photo stays in view when it's cropped to fit. */
  focus?: ImgFocus;
  /** Rounded corners; turn off when the photo sits flush inside a card that already clips it. */
  rounded?: boolean;
  class?: string;
}

const {
  src,
  alt,
  ratio = 'landscape',
  widths = [480, 800, 1200, 1600],
  sizes = '100vw',
  priority = false,
  focus = 'center',
  rounded = true,
  class: className,
} = Astro.props;


const ratios: Record<ImgRatio, string> = {
  portrait: 'aspect-4/5',
  tall: 'aspect-2/3',
  landscape: 'aspect-3/2',
  wide: 'aspect-video',
  square: 'aspect-square',
  fill: 'h-full',
};
---

<Picture
  src={src}
  alt={alt}
  widths={widths.filter((w) => w <= src.width)}
  sizes={sizes}
  formats={['avif', 'webp']}
  fallbackFormat="jpg"
  priority={priority}
  pictureAttributes={{
    class: ['block overflow-hidden', rounded && 'rounded-media', ratios[ratio], className].filter(Boolean).join(' '),
  }}
  class:list={['h-full w-full object-cover', focusClass[focus]]}
/>
