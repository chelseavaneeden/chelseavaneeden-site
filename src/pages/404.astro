---
import Base from '../layouts/Base.astro';
import Button from '../components/ui/Button.astro';
import Eyebrow from '../components/ui/Eyebrow.astro';
import Heading from '../components/ui/Heading.astro';
import Section from '../components/ui/Section.astro';
import Text from '../components/ui/Text.astro';
import Footer from '../components/patterns/Footer.astro';
import Header from '../components/patterns/Header.astro';
import { getSite } from '../lib/content';

const site = await getSite();
---

<Base title="Page not found · Chelsea van Eeden" noindex>
  <Header nav={site.nav} cta={site.bookCta} />
  <main id="main">
    <Section space="l" width="narrow">
      <div class="flex flex-col items-start gap-6">
        <Eyebrow>404</Eyebrow>
        <Heading level={1} variant="display-l" text="This page *isn’t* here" />
        <Text variant="lede" tone="muted">
          It may have moved, or it’s still being written. Head back to the home page, or tell me what you were looking
          for.
        </Text>
        <div class="flex flex-wrap gap-3">
          <Button href="/" icon="arrow-right">Back to home</Button>
          <Button href="/enquire" variant="secondary">Start an enquiry</Button>
        </div>
      </div>
    </Section>
  </main>
  <Footer links={site.footerLinks} tagline={site.tagline} location={site.location} socials={site.socials} legal={site.legal} copyrightYear={site.copyrightYear} />
</Base>
