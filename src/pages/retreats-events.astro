---
// Retreats & events: the page for retreat hosts, festivals, teams and brands, and the link to use in
// outreach emails. Content is edited in the editor under "Retreats & events page"; the proposal form's
// questions under Site settings → Enquiry forms → proposal.
import AudiencePage from '../layouts/AudiencePage.astro';
import Card from '../components/ui/Card.astro';
import EnquiryForm from '../components/patterns/EnquiryForm.astro';
import { getSite } from '../lib/content';

const site = await getSite();
---

<AudiencePage audience="hospitality">
  <Card slot="enquiry" variant="paper" padding="m">
    <EnquiryForm type="proposal" enquiry={site.enquiry} contact={site.contact} />
  </Card>
</AudiencePage>
