---
// Retreats & events: the page for retreat hosts, festivals, teams and brands, and the link to use in
// outreach emails. Content is edited in the editor under "Service pages → Retreats & events"; the
// proposal form's questions under Site settings → Enquiry forms → proposal.
import AudiencePage from '../layouts/AudiencePage.astro';
import EnquiryForm from '../components/patterns/EnquiryForm.astro';
import { getSite } from '../lib/content';

const site = await getSite();
---

<AudiencePage audience="hospitality">
  <EnquiryForm slot="enquiry" type="proposal" enquiry={site.enquiry} contact={site.contact} />
</AudiencePage>
