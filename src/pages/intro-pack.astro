---
// The intro session page: every "Book your Session" button leads here. It shows only the intro-only
// Stripe pricing table, so a new client has one choice and one Pay button, then what happens next.
// Words and the table ID: Site settings → Intro session page. After paying, Stripe sends people to /welcome
// (set in Stripe on the pricing table).
import Base from '../layouts/Base.astro';
import Button from '../components/ui/Button.astro';
import Section from '../components/ui/Section.astro';
import Sunlight from '../components/ui/Sunlight.astro';
import Footer from '../components/patterns/Footer.astro';
import Header from '../components/patterns/Header.astro';
import NumberedList from '../components/patterns/NumberedList.astro';
import SectionHeader from '../components/patterns/SectionHeader.astro';
import StripePricingTable from '../components/patterns/StripePricingTable.astro';
import { getSite } from '../lib/content';

const site = await getSite();
const intro = site.introPack;
---

<Base
  title="Book your Session · Chelsea van Eeden"
  description="A live 1-to-1 Pilates intro session online with Chelsea van Eeden. Pay securely, then pick your time."
>
  <Header nav={site.nav} cta={site.bookCta} />
  <main id="main">
    {/* The home page header's sunrise glow, running up behind the menu. */}
    <Section space="none" class="relative isolate -mt-(--header-h) overflow-hidden bg-surface pt-(--hero-pad) pb-(--space-section-m) md:-mt-(--header-h-md) md:pt-(--hero-pad-md)">
      <Sunlight />
      <div class="flex flex-col items-center gap-10">
        <SectionHeader eyebrow={intro.eyebrow} title={intro.title} intro={intro.intro} layout="centered" />
        {/* Stripe paints its own background. Darken lets the glow show through it, so there is no box around the
            table, as long as Stripe's background colour (Stripe → Pricing tables) is as light as the page's. */}
        <div class="w-full mix-blend-darken">
          <StripePricingTable pricingTableId={intro.stripePricingTableId} publishableKey={site.stripePublishableKey} />
        </div>
        {intro.points.length > 0 && <NumberedList items={intro.points} />}
        <p class="type-body-s flex flex-wrap items-center justify-center gap-x-2 gap-y-1 text-center text-ink-muted">
          Questions first?
          <Button href="/enquire" variant="link" event="intro_page">Ask me</Button>
        </p>
      </div>
    </Section>
  </main>
  <Footer links={site.footerLinks} tagline={site.tagline} location={site.location} socials={site.socials} legal={site.legal} copyrightYear={site.copyrightYear} />
</Base>
