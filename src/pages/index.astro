---
// Home page: the page for 1-on-1 clients. All words, images and prices come from the editor
// (src/content/pages/home.yaml, offers/, testimonials/ and settings/site.yaml). The testimonials
// heading and the questions are shared with src/content/audience-pages/private.yaml, so they are
// edited in one place. Section ids (investment, reviews, about, faq) are the menu links in Site settings.
// Order: header, who it's for, intro pack, how it works, reviews, Meet Chelsea, questions, closing band.
// Retreats, events and brands have their own page: /retreats-events.
import Base from '../layouts/Base.astro';
import AvailabilityBadge from '../components/ui/AvailabilityBadge.astro';
import Eyebrow from '../components/ui/Eyebrow.astro';
import Heading from '../components/ui/Heading.astro';
import Section from '../components/ui/Section.astro';
import Text from '../components/ui/Text.astro';
import Checklist from '../components/patterns/Checklist.astro';
import LogoStrip from '../components/patterns/LogoStrip.astro';
import CtaBand from '../components/patterns/CtaBand.astro';
import FAQAccordion from '../components/patterns/FAQAccordion.astro';
import Footer from '../components/patterns/Footer.astro';
import Header from '../components/patterns/Header.astro';
import Hero from '../components/patterns/Hero.astro';
import OfferGrid from '../components/patterns/OfferGrid.astro';
import PhotoCollage from '../components/patterns/PhotoCollage.astro';
import StepList from '../components/patterns/StepList.astro';
import TestimonialGrid from '../components/patterns/TestimonialGrid.astro';
import TrustLine from '../components/patterns/TrustLine.astro';
import teachingOnline from '../assets/media/chelsea-teaching-online.jpg';
import { getAudiencePage, getOffers, getPage, getSite, getTestimonials, resolveHeroLinks } from '../lib/content';

const site = await getSite();
const page = await getPage('home');
const shared = await getAudiencePage('private');
const hero = resolveHeroLinks(page.hero, site);
const offers = await getOffers('private');
const testimonials = await getTestimonials('private');
---

<Base title={page.seo.title} description={page.seo.description}>
  <Header nav={site.nav} cta={site.bookCta} sections={['reviews', 'about', 'faq']} />

  <main id="main">
    <Hero layout="split" {...hero}>
      <AvailabilityBadge slot="badge" {...site.availability} />
      <TrustLine slot="trust" trust={site.trust} />
    </Hero>

    {
      page.perfectFor && (
        <Section space="m" tone="alt" tint="sage">
          <Checklist {...page.perfectFor} />
        </Section>
      )
    }

    {
      offers.length > 0 && (
        <Section space="m" id="investment" labelledby="investment-title">
          <OfferGrid
            eyebrow={page.investment.eyebrow}
            title={page.investment.title}
            intro={page.investment.intro}
            note={page.investment.note}
            offers={offers}
            headingId="investment-title"
          />
        </Section>
      )
    }

    {
      page.steps && (
        <Section space="m" class="pt-0">
          <StepList {...page.steps} />
        </Section>
      )
    }

    {
      testimonials.length > 0 && (
        <Section space="m" tone="alt" id="reviews">
          <TestimonialGrid
            eyebrow={shared.proof.eyebrow}
            title={shared.proof.title}
            testimonials={testimonials}
            rating={{ value: site.trust.googleRating, count: site.trust.googleReviewCount }}
          />
        </Section>
      )
    }

    <Section space="l" tone="light" id="about" class="relative isolate overflow-hidden">
      {/* The greeting sits above the words in one moss green; the words are larger so they balance the
          photos. */}
      <div class="grid grid-cols-1 items-center gap-16 lg:grid-cols-12">
        <div data-reveal class="flex flex-col gap-6 lg:col-span-6">
          {page.about.eyebrow && <Eyebrow>{page.about.eyebrow}</Eyebrow>}
          <Heading variant="h1" tone="brand" text={page.about.title} class="em-plain" />
          {page.about.paragraphs.map((p) => <Text variant="lede" tone="muted" text={p} />)}
        </div>
        <PhotoCollage
          class="mx-auto w-full max-w-xl lg:col-span-5 lg:col-start-8"
          photos={[
            { src: page.about.image, alt: page.about.imageAlt },
            { src: teachingOnline, alt: 'Chelsea guiding a client through a live online Reformer session' },
          ]}
        />
      </div>
    </Section>

    {
      page.logos && (
        <Section space="s" bare class="pt-0">
          <LogoStrip {...page.logos} />
        </Section>
      )
    }

    {
      shared.faq && (
        <Section space="m" tone="alt" id="faq">
          <FAQAccordion {...shared.faq} />
        </Section>
      )
    }

    {page.ctaBand && <CtaBand {...page.ctaBand} />}
  </main>

  <Footer links={site.footerLinks} tagline={site.tagline} location={site.location} socials={site.socials} legal={site.legal} copyrightYear={site.copyrightYear} />
</Base>
