---
// Home page. All words, images and prices come from the editor (src/content/pages/home.yaml,
// offers/, testimonials/ and settings/site.yaml); this file only arranges them.
import Base from '../layouts/Base.astro';
import Section from '../components/ui/Section.astro';
import CtaBand from '../components/patterns/CtaBand.astro';
import AnnouncementBar from '../components/patterns/AnnouncementBar.astro';
import DoorSpines from '../components/patterns/DoorSpines.astro';
import Marquee from '../components/patterns/Marquee.astro';
import portraitPhoto from '../assets/media/chelsea-portrait.jpg';
import teachingOnline from '../assets/media/chelsea-teaching-online.jpg';
import Footer from '../components/patterns/Footer.astro';
import Header from '../components/patterns/Header.astro';
import Hero from '../components/patterns/Hero.astro';
import MediaSplit from '../components/patterns/MediaSplit.astro';
import OfferGrid from '../components/patterns/OfferGrid.astro';
import ProofStrip from '../components/patterns/ProofStrip.astro';
import Testimonial from '../components/patterns/Testimonial.astro';
import { getOffers, getPage, getSite, getTestimonials } from '../lib/content';

const site = await getSite();
const page = await getPage('home');
const offers = await getOffers('private');
const [testimonial] = await getTestimonials('private');
---

<Base title={page.seo.title} description={page.seo.description}>
  <AnnouncementBar availability={site.availability} />
  <Header nav={site.nav} cta={site.bookCta} />

  <main id="main">
    <Hero
      layout="fullbleed"
      {...page.hero}
      image={portraitPhoto}
      imageAlt="Chelsea van Eeden smiling during an online session"
      imageFocus="center"
    />

    {
      site.stats.length > 0 && (
        <Section space="none" width="wide" class="pb-(--space-section-s)">
          <ProofStrip stats={site.stats} />
        </Section>
      )
    }

    <Section space="m" width="wide">
      <DoorSpines doors={page.doors.items} eyebrow={page.doors.eyebrow} title={page.doors.title} />
    </Section>

    <Marquee phrases={['Strength with ease', 'Pilates that meets you where you are', 'Online & in Lisbon']} />

    <Section space="m" tone="dark">
      <MediaSplit
        image={teachingOnline}
        imageAlt="Chelsea guiding a client through a live online Reformer session"
        eyebrow={page.about.eyebrow}
        title={page.about.title}
        text={page.about.paragraphs}
        cta={page.about.cta}
        ratio="portrait"
        reverse
      />
    </Section>

    {
      offers.length > 0 && (
        <Section space="m" id="investment" labelledby="investment-title">
          <OfferGrid
            eyebrow={page.investment.eyebrow}
            title={page.investment.title}
            intro={page.investment.intro}
            note={page.investment.note}
            offers={offers}
            headingId="investment-title"
            contact={{ lead: site.contact.whatsappLead, label: site.contact.whatsappLabel, href: site.contact.whatsappHref }}
          />
        </Section>
      )
    }

    {
      testimonial && (
        <Section space="m" tone="alt">
          <Testimonial quote={testimonial.quote} name={testimonial.name} context={testimonial.context} align="center" />
        </Section>
      )
    }

    <CtaBand {...page.ctaBand} />
  </main>

  <Footer nav={site.nav} tagline={site.tagline} location={site.location} socials={site.socials} legal={site.legal} />
</Base>
