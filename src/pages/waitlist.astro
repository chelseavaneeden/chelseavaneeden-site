---
// Join the waitlist, while Chelsea is fully booked. The same form also opens as a pop-up from every link to
// /waitlist (the Join waitlist buttons); this page is for links from outside the site and browsers without
// JavaScript. Not in search. Words: Site settings → Enquiry forms → waitlist.
import Base from '../layouts/Base.astro';
import Card from '../components/ui/Card.astro';
import Section from '../components/ui/Section.astro';
import EnquiryForm from '../components/patterns/EnquiryForm.astro';
import Footer from '../components/patterns/Footer.astro';
import Header from '../components/patterns/Header.astro';
import SectionHeader from '../components/patterns/SectionHeader.astro';
import { getSite } from '../lib/content';

const site = await getSite();
const form = site.enquiry.forms.waitlist;
---

<Base title="Join the waitlist · Chelsea van Eeden" description="Join Chelsea van Eeden's waitlist for private online Pilates sessions." noindex>
  <Header nav={site.nav} cta={site.bookCta} />
  <main id="main">
    <Section space="m">
      <div class="mx-auto flex max-w-2xl flex-col gap-10" data-form-scope>
        <div data-form-intro>
          <SectionHeader level={1} title={form.title} intro={form.intro} />
        </div>
        <Card variant="paper" padding="m">
          <EnquiryForm type="waitlist" enquiry={site.enquiry} contact={site.contact} idPrefix="page-waitlist" />
        </Card>
      </div>
    </Section>
  </main>
  <Footer links={site.footerLinks} tagline={site.tagline} location={site.location} socials={site.socials} legal={site.legal} copyrightYear={site.copyrightYear} />
</Base>
