---
// The intake page. Clients book and pay in Google Calendar on /intro-pack; the email MailerLite sends them
// straight after links here (/welcome#intake). The form is saved in Notion (worker/). Hidden from search engines.
// Words: Site settings → Intake page; the questions: Site settings → Enquiry forms → intake.
import Base from '../layouts/Base.astro';
import Card from '../components/ui/Card.astro';
import Heading from '../components/ui/Heading.astro';
import Section from '../components/ui/Section.astro';
import Text from '../components/ui/Text.astro';
import EnquiryForm from '../components/patterns/EnquiryForm.astro';
import Footer from '../components/patterns/Footer.astro';
import Header from '../components/patterns/Header.astro';
import SectionHeader from '../components/patterns/SectionHeader.astro';
import { getSite } from '../lib/content';

const site = await getSite();
const w = site.welcome;
---

<Base title="Tell me about you · Chelsea van Eeden" description="One quick step before your first session: tell me about you." noindex pageEvent="intake_open">
  <Header nav={site.nav} cta={site.bookCta} />
  <main id="main">
    <Section space="m">
      <div class="mx-auto flex max-w-narrow flex-col gap-10">
        <SectionHeader level={1} title={w.title} intro={w.intro} />

        <div id="intake" class="scroll-mt-(--header-h)">
          <Card variant="raised" padding="m" class="flex flex-col gap-4">
            <Heading level={2} variant="h3" text={w.intakeTitle} />
            {w.intakeText && <Text tone="muted" text={w.intakeText} />}
            <EnquiryForm type="intake" enquiry={site.enquiry} contact={site.contact} />
          </Card>
        </div>
      </div>
    </Section>
  </main>
  <Footer links={site.footerLinks} tagline={site.tagline} location={site.location} socials={site.socials} legal={site.legal} copyrightYear={site.copyrightYear} />
</Base>
