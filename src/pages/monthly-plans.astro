---
// Monthly plans: Stripe pricing table with checkout. Copy and Stripe IDs live in Site settings → Monthly plans page.
import Base from '../layouts/Base.astro';
import Section from '../components/ui/Section.astro';
import WhatsAppLink from '../components/ui/WhatsAppLink.astro';
import Footer from '../components/patterns/Footer.astro';
import Header from '../components/patterns/Header.astro';
import SectionHeader from '../components/patterns/SectionHeader.astro';
import StripePricingTable from '../components/patterns/StripePricingTable.astro';
import { getSite } from '../lib/content';

const site = await getSite();
const plans = site.monthlyPlans;
if (!plans) throw new Error('Add the Monthly plans page in Site settings (src/content/settings/site.yaml).');
---

<Base
  title="Monthly plans · Chelsea van Eeden"
  description="Choose a monthly plan of live online one-to-one Pilates sessions with Chelsea van Eeden."
>
  <Header nav={site.nav} cta={site.bookCta} availability={site.availability} />
  <main id="main">
    <Section space="m">
      <div class="flex flex-col gap-12">
        <SectionHeader eyebrow={plans.eyebrow} title={plans.title} intro={plans.intro} layout="centered" />
        <StripePricingTable pricingTableId={plans.stripePricingTableId} publishableKey={plans.stripePublishableKey} />
        {
          site.contact.whatsappHref && (
            <p class="type-body-s flex flex-wrap items-center justify-center gap-x-2 gap-y-1 text-center text-ink-muted">
              Questions first?{' '}
              <WhatsAppLink href={site.contact.whatsappHref} label={site.contact.whatsappLabel} />
            </p>
          )
        }
      </div>
    </Section>
  </main>
  <Footer nav={site.nav} tagline={site.tagline} location={site.location} socials={site.socials} legal={site.legal} copyrightYear={site.copyrightYear} />
</Base>
