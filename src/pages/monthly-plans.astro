---
// Monthly plans, for clients continuing after their intro pack. Linked from nowhere on the site and
// hidden from search engines: send the link to clients yourself.
// Words and the table ID: Site settings → Monthly plans page. Until a monthly pricing table is set,
// the page shows a short message with ways to get in touch.
import Base from '../layouts/Base.astro';
import Button from '../components/ui/Button.astro';
import Section from '../components/ui/Section.astro';
import Text from '../components/ui/Text.astro';
import WhatsAppLink from '../components/ui/WhatsAppLink.astro';
import Footer from '../components/patterns/Footer.astro';
import Header from '../components/patterns/Header.astro';
import SectionHeader from '../components/patterns/SectionHeader.astro';
import StripePricingTable from '../components/patterns/StripePricingTable.astro';
import { getSite } from '../lib/content';

const site = await getSite();
const plans = site.monthlyPlans;
---

<Base
  title="Monthly plans · Chelsea van Eeden"
  description="Monthly plans of live online one-to-one Pilates sessions with Chelsea van Eeden."
  noindex
>
  <Header nav={site.nav} cta={site.bookCta} />
  <main id="main">
    <Section space="m">
      <div class="flex flex-col items-center gap-10">
        <SectionHeader eyebrow={plans.eyebrow} title={plans.title} intro={plans.intro} layout="centered" />
        {
          plans.stripePricingTableId ? (
            <div class="w-full">
              <StripePricingTable pricingTableId={plans.stripePricingTableId} publishableKey={site.stripePublishableKey} />
            </div>
          ) : (
            <div class="flex flex-col items-center gap-5 text-center">
              <Text tone="muted" text={plans.noTableText} />
              <div class="flex flex-wrap items-center justify-center gap-x-6 gap-y-3">
                <Button href="/enquire" event="monthly_page">Send me a message</Button>
                {site.contact.whatsappHref && <WhatsAppLink href={site.contact.whatsappHref} label={site.contact.whatsappLabel} size="m" />}
              </div>
            </div>
          )
        }
      </div>
    </Section>
  </main>
  <Footer nav={site.nav} tagline={site.tagline} location={site.location} socials={site.socials} legal={site.legal} copyrightYear={site.copyrightYear} />
</Base>
